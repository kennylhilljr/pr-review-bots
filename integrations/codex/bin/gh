#!/usr/bin/env bash
# gh shim for Codex sessions. Feedback writes go through prbot as the review bot,
# reads run the real gh unchanged, and anything classify can't answer is refused.
set -euo pipefail
shim_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
prbot="$shim_dir/../../../prbot"
bot="${PRBOT_BOT:-codex}"

# Every call is classified, whatever the environment says. prbot runs the real gh itself with this directory
# taken off PATH, so it never comes back through here and needs no bypass (PRBOT_ACTIVE is not trusted).
out=""
rc=0
out="$("$prbot" classify -- "$@")" || rc=$?
if [ "$rc" = "0" ] && [ "$out" = "write" ]; then
  exec "$prbot" gh "$bot" -- "$@"
elif [ "$rc" = "1" ] && [ "$out" = "read" ]; then
  :
else
  echo "gh shim: classify did not return a trusted answer (exit $rc, stdout '$out'); refusing to run real gh" >&2
  if [ "$rc" = "0" ]; then rc=1; fi
  exit "$rc"
fi

clean_path=""
IFS=':' read -r -a parts <<< "$PATH"
for p in "${parts[@]}"; do
  [ -d "$p" ] && [ "$(cd "$p" && pwd -P)" = "$shim_dir" ] && continue
  clean_path="${clean_path:+$clean_path:}$p"
done
real_gh="$(PATH="$clean_path" command -v gh)" || { echo "gh shim: real gh not found" >&2; exit 127; }
exec "$real_gh" "$@"
