GUARD_TEST_MODULES = ("unittest", "pytest", "py_compile", "json.tool")
GH_SAFE = {("pr", "view"), ("pr", "diff"), ("pr", "list"), ("pr", "checks"), ("pr", "status"),
           ("issue", "view"), ("issue", "list"), ("issue", "status"), ("repo", "view"), ("run", "view"),
           ("run", "list"), ("run", "watch"), ("workflow", "list"), ("workflow", "view"), ("release", "list"),
           ("release", "view"), ("label", "list"), ("auth", "status")}
GH_SAFE_GROUPS = ("search",)
# write commands that are not PR or issue feedback; the guard leaves them on the user's account, as before
GH_UNGUARDED = {("pr", "create"), ("issue", "create"), ("pr", "merge"), ("pr", "edit"), ("pr", "checkout"),
                ("pr", "ready"), ("repo", "clone")}
# options whose value may be a double-quoted $(...) such as a heredoc message: one word, so it can't add options
GUARD_MESSAGE_OPTIONS = ("-m", "--message", "-F", "--file", "-b", "--body", "-t", "--title", "--body-file")
GIT_SAFE_GLOBALS = ("--no-pager", "-P", "--no-optional-locks", "--literal-pathspecs", "--glob-pathspecs",
                    "--noglob-pathspecs", "--icase-pathspecs", "--no-replace-objects", "--version", "--help")
GIT_READ = {"status", "log", "diff", "show", "rev-parse", "rev-list", "ls-files", "ls-tree", "cat-file", "blame",
            "describe", "shortlog", "merge-base", "show-ref", "for-each-ref", "grep", "diff-tree", "diff-files",
            "diff-index", "name-rev", "count-objects", "check-ignore", "check-attr", "whatchanged", "range-diff",
            "cherry", "version", "reflog"}
# local work that makes no commit and talks to no remote as the user, except fetch and clone, which only read
GIT_LOCAL = {"add", "rm", "mv", "restore", "checkout", "switch", "reset", "clean", "apply", "init", "stash",
             "worktree", "branch", "tag", "remote", "fetch", "clone"}
# commits and pushes: through prbot in the bots' repos, as the user elsewhere
GIT_IDENTITY = {"commit", "push", "merge", "pull", "rebase", "cherry-pick", "revert", "am", "commit-tree", "notes"}
# options that make git run a program named on the command line, or write a file the guard has to protect
GIT_RUNS_PROGRAM = ("--upload-pack", "--receive-pack", "--exec", "--output", "--open-files-in-pager", "--config",
                    "--template", "--ext-diff", "--extcmd", "--tool")
GIT_RUNS_PROGRAM_SHORT = {"clone": "cu", "grep": "O", "rebase": "x", "pull": "", "fetch": "", "push": ""}
REMOTE_URL = re.compile(r"github\.com(?::[0-9]+)?[:/]+([^/\s:]+)/", re.I)


class _Guard:
    def __init__(self, cwd, owners, codex_triggers_as_bot):
        self.dir, self.owners, self.codex = cwd, {o.lower() for o in owners}, codex_triggers_as_bot
        self.feedback, self.gh_other, self.git, self.reasons = [], [], [], []
        self.repo_changed = False  # an earlier git clone/init/worktree/remote may have made a bot repo
        self.cd_seen = False
        self.physical = False  # set -P or set -o physical: later cds resolve symlinks first

    def block(self, reason):
        if reason not in self.reasons:
            self.reasons.append(reason)

    def run(self, command, depth=0, relevant=False):
        try:
            cmds = shell_commands(command)
        except Unparseable as e:
            if _mentions_guarded(command) or GUARD_SUSPICIOUS.search(command):
                self.block(f"the guard cannot read this command ({e})")
            return
        relevant = relevant or _mentions_guarded(command)  # sh -c text inside a strict command stays strict
        for cmd in cmds:
            self.command(cmd, relevant, depth)

    def command(self, cmd, relevant, depth):
        words = cmd.words
        if cmd.op_before == "||" and self.cd_seen:
            self.dir = None  # runs only when what came before failed, a cd included
        for a in cmd.assigns:
            name = a.text.split("=", 1)[0].rstrip("+")
            if name in GUARD_CODE_VARS:
                self.block(f"setting {name} can run code")
            if self.stores_code(a):
                self.block("a value holding $( or a backtick can run later (arithmetic, PS4, ${x@P})")
        everything = list(words) + list(cmd.assigns) + [t for _, t in cmd.redirects]
        if any(re.search(r"\[.*(\$\(|`)", a.text.replace(DYN, "")) for a in everything):
            self.block("an array subscript holding $( or a backtick runs it")
        first = os.path.basename(words[0].text) if words else ""
        if cmd.dbl_bracket and any(a.text in ("-eq", "-ne", "-lt", "-le", "-gt", "-ge") for a in words):
            self.block("[[ ... -eq ... ]] evaluates its operands as arithmetic, which can run code")
        if first in ("let",) or (first in ("declare", "typeset", "local") and any(
                a.text.startswith("-") and "i" in a.text for a in words[1:])):
            self.block(f"{first} evaluates arithmetic, which can run code")
        if first in GUARD_ARITH_NAMES and any("[" in a.text and (a.dynamic or "$(" in a.text or "`" in a.text)
                                              for a in words[1:]):
            self.block(f"{first} with a subscript only known at run time")
        if words and os.path.basename(words[0].text) in GUARD_STORES and (
                any(self.stores_code(a) for a in words[1:]) or any(self.stores_code(t) for _, t in cmd.redirects)):
            self.block("a value holding $( or a backtick can run later (arithmetic, PS4, ${x@P})")
        if relevant and not words:
            for a in cmd.assigns:  # x=$(git rev-parse HEAD): the value is checked where it is used
                name = a.text.split("=", 1)[0].rstrip("+")
                if name in GUARD_RISKY_VARS or name.startswith(("GH_", "GIT_", "LD_", "DYLD_", "BASH_")):
                    self.block(f"setting {name} is not on the safe list")
            cmd.assigns = []
        if relevant:
            if cmd.complex:
                self.block("if/for/while blocks, subshells and { } groups are not on the safe list")
            for a in cmd.assigns:
                name = a.text.split("=", 1)[0].rstrip("+")
                if name not in GUARD_SAFE_ENV or a.dynamic:
                    self.block(f"setting {name} before a command is not on the safe list")
            for op, target in cmd.redirects:
                if not self.safe_redirect(op, target):
                    self.block("output redirection to a file is not on the safe list (2>&1 and /dev/null are)")
        if not words:
            return
        prog_at, wrappers, opaque = self.unwrap(words)
        if opaque:
            self.block(f"cannot tell which program `{opaque}` runs")
            return
        if prog_at is None:
            if "xargs" in wrappers:
                self.block("xargs running a program named on stdin")
            return
        prog, args = words[prog_at], words[prog_at + 1:]
        head, _, tail = prog.text.rpartition("/")
        if prog.glob or (prog.dynamic and (DYN in tail or not head)):
            self.block("the program name is only known at run time")
            return
        # $HOME/bin/tool: the directory is only known at run time, the program name is not
        if wrappers and relevant:
            self.block(f"wrappers such as {wrappers[0]} are not on the safe list")
        name = tail.lower()
        if name in GUARD_SHELLS:
            self.shell(name, args, cmd, relevant, depth)
            return
        if name in GUARD_RUNNERS and any(a.dynamic or a.glob for a in args):
            self.block(f"{name} running a command made at run time")
            return
        if re.fullmatch(GUARD_INTERPRETERS, name) and any(
                args[k].text in ("-c", "-e", "-E", "--eval", "-r") and k + 1 < len(args) and args[k + 1].dynamic
                for k in range(len(args))):
            self.block(f"{name} running code only known at run time")
            return
        if name == "eval":
            if any(a.dynamic for a in args):
                self.block("eval of text that is only known at run time")
            elif depth >= GUARD_MAX_DEPTH:
                self.block("commands nested too deeply")
            else:
                self.run(" ".join(a.text for a in args), depth + 1, relevant)
            return
        if name in GUARD_EVAL_LIKE:
            if any(a.dynamic or a.glob for a in args):
                self.block(f"{name} with text only known at run time")
            elif name == "trap" and args and not args[0].text.startswith("-"):
                self.run(args[0].text, depth + 1, relevant) if depth < GUARD_MAX_DEPTH else self.block(
                    "commands nested too deeply")
            if relevant:
                self.block(f"`{name}` is not on the safe list")
            return
        if name in ("source", ".") and any(a.dynamic or a.glob or a.text in GUARD_STDIN_PATHS
                                           or a.text.startswith(("/dev/", "/proc/")) for a in args):
            self.block("source of a file that is only known at run time")
            return
        if re.fullmatch(GUARD_INTERPRETERS, name) and cmd.piped and not any(
                not a.text.startswith("-") or a.text in ("-c", "-e", "-E", "-m") for a in args):
            self.block(f"{name} reading a program from a pipe")
            return
        if name == "set" and any((a.text[:1] in "-+" and "P" in a.text) or a.text == "physical" for a in args):
            self.physical = True
        if name in ("cd", "pushd", "popd"):
            self.cd_seen = True
            if cmd.nested or cmd.complex or cmd.op_before not in (None, ";", "\n") or cmd.op_after in ("|", "|&", "&"):
                self.dir = None  # it may not run, or runs in a subshell: the directory afterwards is unknown
            else:
                self.chdir(name, args)
        if not relevant:
            return
        if name == "gh":
            self.gh(args)
        elif name == "git":
            self.git_call(args)
        elif name == "prbot":
            pass  # posts as a bot: the route the guard points to
        elif name in GUARD_SAFE_PROGRAMS:
            if name == "printf" and any(a.text.startswith("-v") for a in args):
                self.block("printf -v is not on the safe list")
            if name == "rg" and any(a.text.startswith(("--pre", "--hostname-bin")) for a in args):
                self.block("rg --pre runs another program")
            if name == "sort" and any(a.text.startswith(("-o", "--o", "--compress")) for a in args):
                self.block("sort -o and --compress-program are not on the safe list")
            if name == "uniq" and len([a for a in args if not a.text.startswith("-")]) > 1:
                self.block("uniq with an output file is not on the safe list")
            if name == "set" and any(not a.text.startswith(("-", "+")) for a in args) and not all(
                    a.text in ("pipefail", "errexit", "nounset", "xtrace") or a.text.startswith(("-", "+")) for a in args):
                self.block("set with positional arguments is not on the safe list")
        elif name == "command":
            pass  # command -v / -V: a lookup, nothing runs
        elif self.test_runner(prog.text, name, args):
            pass
        else:
            self.block(f"`{name}` is not on the safe list")

    @staticmethod
    def stores_code(w):
        """True when a word or here-document stores text that bash would run if it is expanded again."""
        text = (w.body or "") + w.text.replace(DYN, "")
        return "$(" in text or "`" in text or (w.ansi and re.search(r"\\[xuU0-7c]", w.raw) is not None)

    @staticmethod
    def safe_redirect(op, target):
        if op in ("<", "<<", "<<-", "<<<"):
            return True
        if target.dynamic:
            return False
        if op in (">&", "<&") and re.fullmatch(r"[0-9]+-?|-", target.text):
            return True
        return op in (">", ">>", "&>", "&>>", ">|", ">&") and target.text == "/dev/null"

    def unwrap(self, words):
        """(index of the program word or None, wrapper names, opaque wrapper name or None)."""
        i, wrappers = 0, []
        while i < len(words):
            w = words[i]
            name = os.path.basename(w.text).lower()
            if w.dynamic or name not in GUARD_WRAPPERS:
                return i, wrappers, None
            if name == "command" and i + 1 < len(words) and words[i + 1].text in ("-v", "-V"):
                return i, wrappers, None  # a lookup: nothing runs
            wrappers.append(name)
            i += 1
            values = GUARD_WRAPPERS[name]
            opaque = GUARD_OPAQUE.get(name, ())
            positional = 1 if name in ("timeout", "gtimeout") else 0
            while i < len(words):
                a = words[i]
                if a.dynamic:
                    return None, wrappers, name
                t = a.text
                if t == "--":
                    i += 1
                    break
                if name == "env" and re.match(r"[A-Za-z_][A-Za-z0-9_]*=", t):
                    i += 1
                    continue
                if t.startswith("-") and len(t) > 1:
                    if any(t == o or (t.startswith(o) and (o.startswith("--") and t[len(o):len(o) + 1] == "="
                                                         or not o.startswith("--"))) for o in opaque) or (
                            not t.startswith("--") and any(o[1] in t[1:] for o in opaque if not o.startswith("--"))):
                        return None, wrappers, name
                    if t in values:
                        i += 2
                    else:
                        i += 1
                    continue
                if positional:
                    positional -= 1
                    i += 1
                    continue
                break
        return None, wrappers, None

    def shell(self, name, args, cmd, relevant, depth):
        script, has_c, from_stdin, i = None, False, False, 0
        while i < len(args):
            a = args[i]
            if a.dynamic:
                self.block(f"{name} with options only known at run time")
                return
            t = a.text
            if t == "--":
                i += 1
                break
            if t[:1] in "-+" and len(t) > 1 and not t.startswith("--"):
                has_c = has_c or "c" in t[1:]
                from_stdin = from_stdin or "s" in t[1:]
                # every o or O in a cluster (-co, -oc, -euo) takes the next word as its option name
                i += 1 + t[1:].count("o") + t[1:].count("O")
                continue
            if t.startswith("--"):
                i += 2 if t in ("--rcfile", "--init-file") else 1
                continue
            break
        rest = args[i:]
        if has_c:
            if not rest or rest[0].dynamic:
                self.block(f"{name} -c with a script only known at run time")
            elif depth >= GUARD_MAX_DEPTH:
                self.block("commands nested too deeply")
            else:
                self.run(rest[0].text, depth + 1, relevant)
            return
        if from_stdin or not rest or rest[0].text in GUARD_STDIN_PATHS or rest[0].text.startswith(("/dev/", "/proc/")):
            self.block(f"{name} reading commands from stdin")
            return
        if rest[0].dynamic or rest[0].glob:
            self.block(f"{name} running a script only known at run time")
            return
        if relevant:
            self.block(f"running a script with {name} is not on the safe list")

    def chdir(self, name, args):
        if self.physical or any(a.text.startswith("-") and a.text != "-" and "P" in a.text for a in args):
            self.dir = None  # cd -P or set -P: .. is folded after symlinks, which the guard does not follow
            return
        positional = [a for a in args if a.text == "-" or not a.text.startswith("-")]
        if name == "popd" or (name == "pushd" and (not positional or len(positional) != len(args))) or (
                positional and (positional[0].dynamic or positional[0].text == "-")):
            self.dir = None  # popd, pushd -n, pushd with no directory: the guard can't follow the stack
        elif not positional:
            self.dir = os.path.expanduser("~")
        elif self.dir is not None or os.path.isabs(os.path.expanduser(positional[0].text)):
            # bash cd is logical: link/.. goes back to where it started, so fold .. before any lookup
            self.dir = os.path.normpath(os.path.join(self.dir or "/", os.path.expanduser(positional[0].text)))

    @staticmethod
    def test_runner(path, name, args):
        texts = [a.text for a in args]
        if path.endswith("scripts/check.sh") or name in ("pytest",):
            return True
        if name in ("npm", "pnpm", "yarn") and texts[:1] == ["test"]:
            return True
        if name == "make" and texts in (["test"], ["check"]):
            return True
        if re.fullmatch(r"python3?(\.[0-9]+)?", name):
            i = 0
            while i < len(texts) and texts[i] in ("-B", "-I", "-u", "-q", "-E", "-s"):
                i += 1
            return texts[i:i + 1] == ["-m"] and i + 1 < len(texts) and texts[i + 1] in GUARD_TEST_MODULES
        return False

    def literal_args(self, args, what, allow_messages=False):
        """Argument texts, or None (and a block) when one is only known at run time. A double-quoted value of a
        message option (-m "$(cat <<'EOF' ...)") is allowed when allow_messages is true: it stays one word."""
        out = []
        for k, a in enumerate(args):
            if a.dynamic:
                prev = args[k - 1].text if k else ""
                if allow_messages and not a.split and prev in GUARD_MESSAGE_OPTIONS:
                    out.append(a.text)
                    continue
                self.block(f"{what} with arguments only known at run time")
                return None
            out.append(a.text)
        return out

    def gh(self, args):
        texts = self.literal_args(args, "gh", allow_messages=True)
        if texts is None:
            return
        group, sub, rest = gh_command(texts)
        if group in ("--version", "version", "--help", "help") and len(texts) == 1:
            return
        if (group, sub) in GH_SAFE or group in GH_SAFE_GROUPS:
            if (group, sub) == ("auth", "status") and any(t in ("-t", "--show-token") for t in texts):
                self.block("gh auth status --show-token prints the token")
            elif any(a.dynamic for a in args):
                self.block("gh reads with arguments only known at run time")
            return
        if (group, sub) in GH_UNGUARDED:
            if (group, sub) == ("repo", "clone"):
                self.repo_changed = True
            return
        if group == "api":
            if any(a.dynamic for a in args):
                self.block("gh api with arguments only known at run time")
            elif not gh_api_is_get(rest):
                self.feedback.append(texts) if is_feedback_write(texts, self.codex) else self.gh_other.append(texts)
            return
        if (group, sub) in WRITE_SUBCOMMANDS | CLOSE_SUBCOMMANDS:
            if is_feedback_write(texts, self.codex):
                self.feedback.append(texts)
            return  # closing without a comment, or a plain @codex trigger comment
        self.gh_other.append(texts)

    def git_call(self, args):
        texts = self.literal_args(args, "git", allow_messages=True)
        if texts is None:
            return
        d, i = self.dir, 0
        while i < len(texts) and texts[i].startswith("-"):
            t = texts[i]
            if t == "-C" and i + 1 < len(texts):
                d = os.path.join(d, os.path.expanduser(texts[i + 1])) if d is not None else (
                    texts[i + 1] if os.path.isabs(texts[i + 1]) else None)
                i += 2
                continue
            if t in GIT_SAFE_GLOBALS:
                i += 1
                continue
            self.block(f"git option {t} is not on the safe list")
            return
        if i >= len(texts):
            return
        sub, rest = texts[i], texts[i + 1:]
        if any(a.dynamic for a in args) and sub not in ("commit", "tag", "notes", "merge"):
            self.block("git with arguments only known at run time")
            return
        short = GIT_RUNS_PROGRAM_SHORT.get(sub, "")
        for t in rest:
            if t == "--":
                break
            long_name = t.split("=", 1)[0]
            # git accepts any unambiguous prefix of a long option, so --upl means --upload-pack
            if (t.startswith("--") and len(long_name) > 2 and any(o.startswith(long_name) or long_name.startswith(o)
                                                                  for o in GIT_RUNS_PROGRAM)) \
                    or (short and t[:1] == "-" and t[1:2] != "-" and any(ch in t[1:] for ch in short)):
                self.block(f"git {sub} {t.split('=')[0]} can run another program")
                return
        if sub == "config":
            if not any(t in ("--get", "--get-all", "--get-regexp", "--list", "-l", "--show-origin") for t in rest) \
                    or any(t in ("--add", "--unset", "--unset-all", "--replace-all", "--edit", "-e") for t in rest):
                self.block("git config that changes settings is not on the safe list")
            return
        if sub in GIT_READ or sub in GIT_LOCAL:
            if sub in ("clone", "init", "worktree", "remote"):
                self.repo_changed = True
            return
        if sub in GIT_IDENTITY:
            if self.bot_repo(d, sub, rest) if d is not None and os.path.isdir(d) else False:
                self.git.append(texts)
            elif d is None or not os.path.isdir(d) or self.repo_changed:
                # the directory is only known at run time, or an earlier step in this command makes or changes
                # the repository, so its owner can't be checked now
                self.block(f"cannot tell which repository git {sub} runs in")
            return
        self.block(f"git {sub} is not on the safe list")

    def bot_repo(self, d, sub, rest):
        """True when git runs in, or may push to or pull from, a repository owned by an account the bots are
        installed on: any remote URL of the repo, a branch remote or remote.pushDefault given as a URL, and, for
        a push, pull or fetch, any word that looks like a remote URL."""
        r = subprocess.run(["git", "config", "--get-regexp",
                            r"^(remote\..*\.(push)?url|branch\..*\.(remote|pushremote)|remote\.pushdefault)$"],
                           capture_output=True, text=True, cwd=d)
        values = [line.partition(" ")[2] for line in r.stdout.splitlines()] if r.returncode == 0 else []
        if any(self.bot_url(v) for v in values):
            return True
        if sub not in ("push", "pull", "fetch"):
            return False
        return any(self.bot_url(t.split("=", 1)[1] if t.startswith("--repo=") else t) for t in rest)

    def bot_url(self, text):
        owner = remote_owner(text or "")
        return owner is not None and owner.lower() in self.owners


def remote_owner(url):
    """The first path segment of a remote URL whatever the host (ssh aliases, IP addresses, ports, a trailing
    dot), or None when the text is not a URL: https://host/OWNER/repo, ssh://git@host:22/OWNER/repo,
    git@alias:OWNER/repo."""
    m = re.match(r"\s*(?:[A-Za-z][A-Za-z0-9+.-]*://[^/\s]*/+|(?:[^/\s@:]+@)?[^/\s:]+:/*)([^/\s]+)/", url)
    return m.group(1) if m else None


def gh_api_is_get(rest):
    """True when a gh api argv (after `api`) is a plain GET: one endpoint, no fields or input, method GET."""
    endpoint, i = None, 0
    plain_long = ("--include", "--paginate", "--slurp", "--silent", "--verbose")
    value_long = ("--header", "--jq", "--template", "--preview", "--hostname", "--cache")

    def value(k, attached):
        return attached if attached else (rest[k + 1] if k + 1 < len(rest) else None)

    while i < len(rest):
        a = rest[i]
        if a.startswith("--") and a != "--":
            name, eq, val = a.partition("=")
            if name in plain_long and not eq:
                i += 1
                continue
            if name == "--method" or name in value_long:
                v = value(i, val if eq else None)
                if v is None or (name == "--method" and v != "GET") or (name == "--header" and "override" in v.lower()):
                    return False
                i += 1 if eq else 2
                continue
            return False
        if a.startswith("-") and len(a) > 1 and a != "--":
            k, step = 1, 1
            while k < len(a):
                ch = a[k]
                if ch in "XHqtp":
                    v = a[k + 1:] or None
                    if v is None:
                        v, step = (rest[i + 1] if i + 1 < len(rest) else None), 2
                    if v is None or (ch == "X" and v != "GET") or (ch == "H" and "override" in v.lower()):
                        return False
                    break
                if ch != "i":
                    return False
                k += 1
            i += step
            continue
        if a == "--":
            if i + 1 < len(rest) and endpoint is None and i + 2 == len(rest):
                return True
            return False
        if endpoint is not None:
            return False
        endpoint = a
        i += 1
    return endpoint is not None


def guard_bash(command, cwd, owners, codex_triggers_as_bot=False):
    """What the Claude Code hook should refuse in a Bash command, as a dict, or None to let it run.

    Keys: feedback (gh argv lists that post PR feedback), git (git argv lists that commit or push in a bot
    repo), gh (other gh argv lists not on the safe list) and reasons (why anything else was refused)."""
    g = _Guard(cwd, set(owners), codex_triggers_as_bot)
    g.run(command)
    if g.feedback or g.git or g.gh_other or g.reasons:
        shown = lambda lists: [[a.replace(DYN, "<run-time value>") for a in args] for args in lists]
        return {"feedback": shown(g.feedback), "git": shown(g.git), "gh": shown(g.gh_other), "reasons": g.reasons}
    return None

# ---------- config and key storage ----------


class ConfigError(Exception):
    pass


def load_config():
    """The config as a dict, {} when there is none. A broken file raises ConfigError; OSError propagates.

    The guard decides from this config, so anything it can't trust is an error, never {}: a dangling symlink, a
    symlink loop (OSError), bytes that are not UTF-8, JSON the parser rejects for any reason, a non-object, and
    a bot entry or field whose type would make the guard's owner check silently match nothing."""
    try:
        text = CONFIG.read_text(encoding="utf-8")
    except FileNotFoundError:
        if os.path.lexists(CONFIG):
            raise ConfigError(f"{CONFIG}: a symlink to a file that does not exist; fix or remove it") from None
        dangling = _dangling_ancestor(CONFIG)
        if dangling:  # the config directory is a broken symlink: there may be a config we can't see, not none
            raise ConfigError(f"{CONFIG}: {dangling} is a symlink to something that does not exist; "
                              "fix or remove it") from None
        return {}
    except UnicodeDecodeError:
        raise ConfigError(f"{CONFIG}: not valid UTF-8 text; fix or remove it") from None
    try:
        cfg = json.loads(text, parse_int=_bounded_int)
    except (ValueError, RecursionError):  # JSONDecodeError, huge integers, very deep nesting
        raise ConfigError(f"{CONFIG}: not valid JSON; fix or remove it") from None
    if not isinstance(cfg, dict):
        raise ConfigError(f"{CONFIG}: top-level value is not a JSON object; fix or remove it")
    for bot in AGENTS:
        entry = cfg.get(bot)
        if bot in cfg and not isinstance(entry, dict):
            raise ConfigError(f"{CONFIG}: \"{bot}\" is not a JSON object; fix or remove it")
        if isinstance(entry, dict) and not (isinstance(entry.get("owner"), str) and entry["owner"]):
            raise ConfigError(f"{CONFIG}: \"{bot}\".owner is not a non-empty string; fix or remove it")
    if not isinstance(cfg.get("codex_triggers_as_bot", False), bool):
        raise ConfigError(f"{CONFIG}: codex_triggers_as_bot is not true or false; fix or remove it")
    return cfg


MAX_INT_DIGITS = 1000


def _bounded_int(digits):
    """json parse_int that refuses huge integers on every Python version (3.9 has no digit limit of its own)."""
    if len(digits) > MAX_INT_DIGITS:
        raise ValueError("integer too long")
    return int(digits)


def _dangling_ancestor(path):
    """The first of path's parent directories that is a symlink whose target does not exist, else None."""
    # Join a relative path with the working directory without normalising: abspath would fold a/link/.. into a
    # before the symlink is ever checked. An absolute path needs no working directory, which may be gone.
    path = Path(path)
    if not path.is_absolute():
        path = Path(os.getcwd()) / path
    for p in path.parents:
        if os.path.islink(p) and not os.path.exists(p):
            return p
    return None


def save_config(cfg):
    write_json_atomic(CONFIG, cfg)


def write_json_atomic(path, data, indent=2):
    """Write JSON through a temp file in the same directory and a rename, so a crash or a full disk never leaves
    a half-written file. The temp name starts with a dot and ends in .tmp, so queue readers skip it."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(json.dumps(data, indent=indent) + "\n")
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def bot_config(bot):
    cfg = load_config().get(bot)
    if not cfg:
        die(f"bot '{bot}' is not registered. Run: prbot register {bot}")
    return cfg


def _keychain():
    return shutil.which("security") and os.environ.get("PRBOT_KEY_STORE") != "file"


def store_key(bot, pem):
    if _keychain():
        enc = base64.b64encode(pem.encode()).decode()  # base64 so the multi-line PEM round-trips through -w
        subprocess.run(["security", "add-generic-password", "-U", "-s", KEYCHAIN_SERVICE, "-a", bot, "-w", enc],
                       check=True, capture_output=True)
        return f"macOS Keychain (service {KEYCHAIN_SERVICE}, account {bot})"
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    path = CONFIG_DIR / f"{bot}.pem"
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(pem)
    return str(path)


def read_key(bot):
    if _keychain():
        r = subprocess.run(["security", "find-generic-password", "-s", KEYCHAIN_SERVICE, "-a", bot, "-w"],
                           capture_output=True, text=True)
        if r.returncode == 0:
            return base64.b64decode(r.stdout.strip()).decode()
    path = CONFIG_DIR / f"{bot}.pem"
    if path.exists():
        return path.read_text()
    die(f"no private key for '{bot}'. Run: prbot import-key {bot} <file.pem>")

# ---------- GitHub API ----------


def _ssl_context():
    ctx = ssl.create_default_context()
    if ctx.cert_store_stats().get("x509_ca", 0) == 0:  # python.org builds on macOS ship no CA store
        for cafile in ("/etc/ssl/cert.pem", "/opt/homebrew/etc/openssl@3/cert.pem", "/usr/local/etc/openssl@3/cert.pem"):
            if os.path.exists(cafile):
                ctx.load_verify_locations(cafile)
                break
    return ctx


def api(method, path, auth=None, body=None):
    req = urllib.request.Request(API + path, method=method, data=json.dumps(body).encode() if body is not None else None)
    req.add_header("Accept", "application/vnd.github+json")
    req.add_header("X-GitHub-Api-Version", "2022-11-28")
    req.add_header("User-Agent", "prbot")
    if auth:
        req.add_header("Authorization", "Bearer " + auth)
    try:
        with urllib.request.urlopen(req, context=_ssl_context(), timeout=30) as r:
            return json.loads(r.read() or b"null")
    except urllib.error.HTTPError as e:
        die(f"GitHub {method} {path} failed: HTTP {e.code} {e.read().decode(errors='replace')[:300]}")


def b64url(data):
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()


def app_jwt(issuer, pem, now=None):
    """RS256 JWT for the App, valid 9 minutes (GitHub allows up to 10). Signed with openssl."""
    now = int(now if now is not None else time.time())
    header = b64url(json.dumps({"alg": "RS256", "typ": "JWT"}, separators=(",", ":")).encode())
    payload = b64url(json.dumps({"iat": now - 60, "exp": now + 540, "iss": str(issuer)}, separators=(",", ":")).encode())
    signing_input = f"{header}.{payload}".encode()
    fd, keyfile = tempfile.mkstemp(prefix="prbot-", suffix=".pem")  # mkstemp creates it 0600
    try:
        with os.fdopen(fd, "w") as f:
            f.write(pem)
        sig = subprocess.run(["openssl", "dgst", "-sha256", "-sign", keyfile], input=signing_input,
                             capture_output=True, check=True).stdout
    finally:
        os.unlink(keyfile)
    return f"{header}.{payload}.{b64url(sig)}"


def installation_token(bot, repo, permissions=None):
    """One-hour token for one repo. Posting needs the default set; pushing asks for {"contents": "write"}."""
    cfg = bot_config(bot)
    jwt = app_jwt(cfg.get("client_id") or cfg["app_id"], read_key(bot))
    owner, name = repo.split("/", 1)
    inst = api("GET", f"/repos/{owner}/{name}/installation", auth=jwt)
    perms = permissions or {k: v for k, v in PERMISSIONS.items() if k != "metadata"}
    tok = api("POST", f"/app/installations/{inst['id']}/access_tokens", auth=jwt,
              body={"repositories": [name], "permissions": perms})
    return tok["token"]

# ---------- repo resolution ----------


def repo_from_args(args):
    for i, a in enumerate(args):
        if a in ("-R", "--repo") and i + 1 < len(args):
            return args[i + 1]
        if a.startswith("--repo="):
            return a.split("=", 1)[1]
    for a in args:
        m = re.match(r"^/?repos/([^/]+)/([^/?]+)", a) or re.match(r"^https://github\.com/([^/]+)/([^/]+)/(pull|issues)/\d+", a)
        if m:
            return f"{m.group(1)}/{m.group(2)}"
    return None


def repo_from_git(cwd=None):
    r = subprocess.run(["git", "remote", "get-url", "origin"], capture_output=True, text=True, cwd=cwd)
    m = re.search(r"github\.com(?::[0-9]+)?[:/]+([^/\s:]+)/([^/\s]+?)(\.git)?/?\s*$", r.stdout, re.I) \
        if r.returncode == 0 else None
    return f"{m.group(1)}/{m.group(2)}" if m else None

# ---------- review routing: the other agent reviews, unless told otherwise ----------

AGENTS = ("claude", "codex")
AGENT_IDS = {
    # review bots (claude-pr-gh, codex-pr-gh) and issue worker bots (claude-dev-gh, codex-dev-gh)
    "claude": {"logins": {"claude", "claude[bot]", "claude-pr-gh[bot]", "claude-dev-gh[bot]"},
               "emails": {"noreply@anthropic.com"}},
    "codex": {"logins": {"codex", "codex-pr-gh[bot]", "codex-dev-gh[bot]", "chatgpt-codex-connector[bot]"},
              "emails": {"codex@openai.com"}},
}
CO_AUTHOR = re.compile(r"(?im)^co-authored-by:.*<([^>]+)>")


def agent_of(login="", email=""):
    login, email = (login or "").lower(), (email or "").lower()
    for agent, ids in AGENT_IDS.items():
        if login in ids["logins"] or email in ids["emails"]:
            return agent
        # bot commit emails look like 349557468+claude-pr-gh[bot]@users.noreply.github.com
        if any(email.endswith(f"+{l}@users.noreply.github.com") for l in ids["logins"] if l.endswith("[bot]")):
            return agent
    return None


def detect_author(pr):
    """(agent or None, reason) from `gh pr view --json labels,commits`. Labels win; then commit authors and
    Co-Authored-By trailers. Human co-authors are ignored; both agents, or neither, means unclear."""
    labels = {l["name"].lower() for l in pr.get("labels", [])}
    tagged = [a for a in AGENTS if f"agent:{a}" in labels]
    if len(tagged) == 1:
        return tagged[0], f"label agent:{tagged[0]}"
    if tagged:
        return None, "it has both agent:claude and agent:codex labels"
    seen = set()
    for c in pr.get("commits", []):
        for a in c.get("authors", []):
            seen.add(agent_of(a.get("login"), a.get("email")))
        for email in CO_AUTHOR.findall(c.get("messageBody") or ""):
            seen.add(agent_of(email=email))
    seen.discard(None)
    if len(seen) == 1:
        agent = seen.pop()
        return agent, f"commits by {agent}"
    if seen:
        return None, "it has commits by both claude and codex"
    return None, "it has no agent label and no claude or codex commits"


def choose_reviewers(author, labels, override=None):
    """(reviewers, reason). An explicit --reviewer or review:* label wins; otherwise the other agent reviews."""
    if override:
        return (list(AGENTS) if override == "both" else [override]), f"requested with --reviewer {override}"
    labels = {l.lower() for l in labels}
    asked = [a for a in AGENTS if f"review:{a}" in labels]
    if asked:
        return asked, "requested with " + " and ".join(f"review:{a}" for a in asked)
    if author:
        other = AGENTS[1 - AGENTS.index(author)]
        return [other], f"cross-review: {author} wrote this PR"
    return [], None


REVIEW_PROMPT = """You are reviewing GitHub pull request {url}: "{title}".
The full diff is attached on stdin. The current directory may be a checkout of the repository; read files there for context if useful.

First read the repository's agent instructions if there are any (AGENTS.md, CLAUDE.md and the files they point to). Breaking a rule written there is a defect.

Find real defects. Check the change for each of these:
- Behavior: wrong results, missed edge cases (empty, missing, duplicate, very large or malformed input), races, and broken assumptions in the code the diff calls or is called by.
- Silent failures: errors caught and dropped, broad catches that also hide unrelated errors, fallbacks or default values returned on error without saying so, retries that give up quietly, and fakes or stubs reachable outside tests.
- Error messages: whether someone who hits the failure can tell what went wrong and what to do next.
- Security: injection, unchecked input reaching a shell, path or query, secrets in code or logs, and permission checks that can be skipped.
- Tests: tests that do not test what they claim, assertions that pass whether or not the code works, and new behavior or error paths with no test that would catch a regression. Name the missing test and the bug it would catch.
- Comments and docs: comments, docstrings and docs that no longer match what the code does after this change.
- Project rules: anything that breaks the agent instructions you read.
Skip style nits a linter would catch, matters of taste, and problems that were there before this PR and that it does not make worse.

Report a finding only when you are at least 80% sure it is real after reading the code involved. If you are less sure, read more of the surrounding code until you are, or leave it out.
For each finding give a priority (P1 breaks something, P2 likely bug, P3 minor), the file and line, what goes wrong with a concrete input, and the fix. Use the labels P1, P2 and P3 only to label findings: prbot counts them to decide whether the review needs attention.
If you find nothing worth reporting, say so in one sentence.

Reply with the review text only, in GitHub Markdown, ready to post. Do not post anything yourself, edit files, or run commands that change state."""


REVIEW_TIMEOUT = 900     # seconds one reviewer CLI may run, unless PRBOT_REVIEW_TIMEOUT says otherwise


def review_timeout():
    """Seconds a reviewer CLI may run. Read when a command needs it, never at import, so a bad value can't break
    `prbot --help` or the commands that never run a review."""
    raw = os.environ.get("PRBOT_REVIEW_TIMEOUT")
    if raw is None:
        return REVIEW_TIMEOUT
    try:
        seconds = int(raw.strip())
    except ValueError:
        seconds = 0
    if seconds < 1:
        die(f"PRBOT_REVIEW_TIMEOUT must be a positive whole number of seconds, not {raw!r}")
    return seconds


def run_reviewer_cli(reviewer, cmd, diff, cwd=None):
    """(returncode, stdout, stderr) of a reviewer CLI. It runs in its own process group, and on timeout the whole
    group is killed: claude and codex start children that keep the output pipes open, so killing only the parent
    would leave prbot waiting and block every PR queued behind this one."""
    timeout = review_timeout()
    p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                         cwd=cwd, start_new_session=True)
    try:
        out, err = p.communicate(diff, timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        p.communicate()
        die(f"{reviewer} review timed out after {timeout}s and was stopped")
    return p.returncode, out, err


def run_review(reviewer, pr, diff, cwd):
    prompt = REVIEW_PROMPT.format(url=pr["url"], title=pr["title"])
    if reviewer == "claude":
        cmd = ["claude", "-p", prompt, "--output-format", "text", "--no-session-persistence", "--strict-mcp-config",
               "--permission-mode", "dontAsk", "--allowedTools", "Read Grep Glob",
               "--disallowedTools", "Bash Edit Write NotebookEdit WebFetch WebSearch"]
        code, out, err = run_reviewer_cli(reviewer, cmd, diff, cwd)
        stdout = out
    else:
        fd, outfile = tempfile.mkstemp(prefix="prbot-codex-", suffix=".md")
        os.close(fd)
        try:
            cmd = ["codex", "exec", "-s", "read-only", "--skip-git-repo-check", "--ephemeral", "-C", cwd,
                   "-o", outfile, prompt]
            code, stdout, err = run_reviewer_cli(reviewer, cmd, diff)
            out = Path(outfile).read_text()
        finally:
            os.unlink(outfile)
    if code != 0 or not out.strip():
        die(f"{reviewer} review failed (exit {code}): {(err or stdout)[-500:]}")
    return out.strip()


def review_body(reviewer, reason, pr, text):
    slug = load_config().get(reviewer, {}).get("slug", reviewer)
    return (f"### {reviewer.capitalize()} review\n\n_{reason[0].upper() + reason[1:]}._\n\n{text}\n\n"
            f"<sub>Reviewed commit `{pr['headRefOid'][:10]}` · posted by {slug}[bot]</sub>\n")


def _real_gh():
    """The gh prbot runs. PRBOT_REAL_GH may not resolve into the Codex shim's directory: the shim sends writes
    back through prbot, so that would loop forever."""
    override = os.environ.get("PRBOT_REAL_GH")
    if override:
        # Compare by file identity, not path text: macOS paths are case-insensitive, so /users/... and /Users/...
        # name the same shim.
        if _same_file(os.path.dirname(os.path.realpath(override)), SHIM_DIR) or _same_file(override, SHIM_DIR / "gh"):
            die(f"PRBOT_REAL_GH points at the Codex gh shim ({override}); set it to the real gh or unset it")
        return override
    gh = shutil.which("gh", path=_path_without_shims())
    if not gh:
        die("gh not found on PATH")
    return gh


def gh_read(args):
    """Reads use the user's own gh login; only posts go through a bot."""
    r = subprocess.run([_real_gh()] + args, capture_output=True, text=True)
    if r.returncode != 0:
        die(f"gh {' '.join(args[:3])} failed: {r.stderr.strip()[:300]}")
    return r.stdout


def cmd_review(target, repo=None, override=None, mode="post", only=None):
    load_config()  # a broken config stops here, before any gh call
    repo =repo or repo_from_args([target]) or repo_from_git()
    if not repo:
        die("cannot tell which repository this PR is in; pass -R owner/repo")
    number = re.sub(r".*/pull/(\d+).*", r"\1", target)
    pr = json.loads(gh_read(["pr", "view", number, "-R", repo, "--json",
                             "number,title,url,headRefOid,labels,commits"]))
    author, why = detect_author(pr)
    reviewers, reason = choose_reviewers(author, [l["name"] for l in pr["labels"]], override)
    if not reviewers:
        print(f"prbot: can't tell who wrote PR #{pr['number']}: {why}.\n"
              f"Ask the user which agent should review it, then rerun with --reviewer claude|codex|both, "
              f"or add a review:claude or review:codex label to the PR.", file=sys.stderr)
        return 3
    if only:  # the watcher asks for just the reviewers still missing on this commit
        reviewers = [r for r in reviewers if r in only]
    print(f"PR #{pr['number']}: author {author or 'unknown'} ({why}); reviewer {' + '.join(reviewers)} ({reason})")
    if mode == "route":
        return 0
    diff = gh_read(["pr", "diff", number, "-R", repo])
    cwd = os.getcwd() if repo_from_git() == repo else tempfile.gettempdir()
    for reviewer in reviewers:
        bot_config(reviewer)  # fail before spending a model run if the bot is not registered
        body = review_body(reviewer, reason, pr, run_review(reviewer, pr, diff, cwd))
        if mode == "dry-run":
            print(body)
            continue
        fd, path = tempfile.mkstemp(prefix="prbot-review-", suffix=".md")
        with os.fdopen(fd, "w") as f:
            f.write(body)
        try:
            env = dict(os.environ, GH_TOKEN=installation_token(reviewer, repo), PRBOT_ACTIVE=reviewer)
            env.pop("GITHUB_TOKEN", None)
            r = subprocess.run([_real_gh(), "pr", "review", number, "-R", repo, "--comment", "--body-file", path],
                               env=env, capture_output=True, text=True)
        finally:
            os.unlink(path)
        if r.returncode != 0:
            die(f"posting the {reviewer} review failed: {r.stderr.strip()[:300]}")
        url = r.stdout.strip() or pr["url"]
        print(f"posted {reviewer} review: {url}")
        findings = count_findings(body)
        if findings:
            openclaw_attention(f"review findings: {repo}#{pr['number']}",
                               {"url": url, "title": pr["title"], "reviewer": f"{reviewer}-pr-gh",
                                "p1_p2_findings": findings, "commit": pr["headRefOid"][:10]})
    return 0

# ---------- OpenClaw: tell it when something needs Kenny ----------

OPENCLAW_RUNTIME = Path(os.environ.get("PRBOT_OPENCLAW_RUNTIME",
                                       Path.home() / ".local/share/openclaw-ecc-orchestrator/runtime/src"))
OPENCLAW_EVENTS = Path(os.environ.get("PRBOT_OPENCLAW_EVENTS",
                                      Path.home() / ".local/state/openclaw-ecc-orchestrator/openclaw-events.jsonl"))
OPENCLAW_RUN = "github"   # one pseudo-run for all GitHub activity, so OpenClaw's run list gets one entry, not one per issue


def openclaw_attention(reason, detail):
    """Append an attention.required event to OpenClaw's event log through the runtime's own writer, which locks,
    orders, redacts and truncates. Never raises and never blocks GitHub work: returns False if it couldn't."""
    try:
        if not OPENCLAW_EVENTS.parent.is_dir() or not OPENCLAW_RUNTIME.is_dir():
            return False
        if str(OPENCLAW_RUNTIME) not in sys.path:
            sys.path.insert(0, str(OPENCLAW_RUNTIME))
        from openclaw_ecc_orchestrator.plugin.events import JsonlEventSink
        JsonlEventSink(str(OPENCLAW_EVENTS)).emit("attention.required", OPENCLAW_RUN, None,
                                                  {"reason": reason[:100], "state": "needs-kenny", "detail": detail})
        return True
    except Exception as e:  # OpenClaw being absent or broken must not stop a review or an issue pass
        print(f"prbot: could not tell OpenClaw: {e}", file=sys.stderr)
        return False


def count_findings(review_text):
    """P1 and P2 findings in a review, by the priority labels the review prompt asks for."""
    return len(re.findall(r"\bP[12]\b", review_text))

# ---------- watch: review new commits on open PRs as they come in ----------

WATCH_STATE = CONFIG_DIR / "watch-state.json"
WATCH_LIMIT = 3          # model runs per pass, so a backlog can't start a burst of reviews
RETRY_AFTER = 3600       # seconds before retrying a reviewer that failed (usage limit, outage)
REVIEWED = re.compile(r"Reviewed commit `([0-9a-f]{7,40})`")


def load_watch_state(dry_run=False):
    """The watch state, or {} when there is none. A damaged file (bad JSON or not an object) is renamed to
    watch-state.json.corrupt-<UTC time> and logged, so it can't crash every later run. A dry run only logs it."""
    if not WATCH_STATE.exists():
        return {}
    try:
        state = json.loads(WATCH_STATE.read_text())
        if isinstance(state, dict):
            return valid_state_entries(state)
    except ValueError:
        pass
    if dry_run:
        watch_log("watch state is damaged; a real run will move it aside and start with an empty state")
        return {}
    bad = WATCH_STATE.with_name(f"{WATCH_STATE.name}.corrupt-{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())}")
    os.replace(WATCH_STATE, bad)
    watch_log(f"watch state was damaged; moved it to {bad} and starting with an empty state")
    return {}


def save_watch_state(state):
    write_json_atomic(WATCH_STATE, state, indent=1)


STATE_KEY = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#\d+@[0-9a-f]{7,40}$")


def state_entry_problem(key, entry, now):
    """Why one watch-state entry can't be used, or None. Entries look like
    "owner/repo#12@0123456789": {"skipped": "<why>", "baseline": true, "failed_claude": <unix time>}."""
    if not STATE_KEY.match(key):
        return "key is not owner/repo#number@commit"
    if not isinstance(entry, dict):
        return f"value is {type(entry).__name__}, not an object"
    for k, v in entry.items():
        if k == "skipped":
            if not isinstance(v, str):
                return "skipped is not a string"
        elif k == "baseline":
            if v is not True:
                return "baseline is not true"
        elif k in (f"failed_{a}" for a in AGENTS):
            if isinstance(v, bool) or not isinstance(v, (int, float)) or not math.isfinite(v):
                return f"{k} is not a time"
            if not 0 < v <= now + 86400:  # unset is 0; more than a day ahead means a broken clock or a bad edit
                return f"{k} is not a plausible time"
        else:
            return f"unknown field {k!r}"
    return None


def valid_state_entries(state):
    """state without the entries that would break a run, logging one line for each dropped entry."""
    now, good = time.time(), {}
    for key, entry in state.items():
        problem = state_entry_problem(key, entry, now)
        if problem:
            watch_log(f"watch state: dropping entry {key!r}: {problem}")
        else:
            good[key] = entry
    return good


def installed_repos(bot):
    """owner/name of every repository the bot's App is installed on."""
    cfg = bot_config(bot)
    jwt = app_jwt(cfg.get("client_id") or cfg["app_id"], read_key(bot))
    repos = set()
    for inst in api("GET", "/app/installations", auth=jwt):
        tok = api("POST", f"/app/installations/{inst['id']}/access_tokens", auth=jwt,
                  body={"permissions": {"metadata": "read"}})["token"]
        page = 1
        while True:
            batch = api("GET", f"/installation/repositories?per_page=100&page={page}", auth=tok)["repositories"]
            repos.update(r["full_name"] for r in batch)
            if len(batch) < 100:
                break
            page += 1
    return repos


def reviewed_by(repo, number, sha, slugs):
    """Bots ({'claude', ...}) that already posted a review of this exact commit, read from the review footers."""
    raw = gh_read(["api", f"repos/{repo}/pulls/{number}/reviews", "--paginate",
                   "--jq", '.[] | [.user.login, (.body // "")] | @json'])
    done = set()
    for line in raw.splitlines():
        login, body = json.loads(line)
        m = REVIEWED.search(body)
        if login in slugs and m and sha.startswith(m.group(1)):
            done.add(slugs[login])
    return done


def watch_log(msg):
    print(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}", flush=True)


def watch_lock():
    """An open file holding the watch lock, or None if another watch run holds it. The queue job and the hourly
    pass are separate launchd jobs and can overlap; without the lock both could review the same commit."""
    path = WATCH_STATE.with_name("watch.lock")
    path.parent.mkdir(parents=True, exist_ok=True)
    f = open(path, "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        f.close()
        return None
    return f


def watch_setup(dry_run, limit, baseline):
    """What every watch run needs: the registered bots, where they are installed, and the review budget.
    "installed" holds only inventories that were read and are not empty. "gaps" says why any bot's inventory
    is missing (not registered, lookup failed, installed nowhere); with a gap, a repository missing from the
    inventory may still be covered, so it must not be treated as unknown and state must not be pruned.
    "lookup_failed" is true when a lookup raised, which is worth a nonzero exit."""
    cfg = load_config()
    bots = [b for b in AGENTS if b in cfg]
    installed, gaps, lookup_failed = {}, [], False
    for b in AGENTS:
        if b not in cfg:
            gaps.append(f"the {b} bot is not registered")
            continue
        try:
            repos = installed_repos(b)
        except (SystemExit, Exception) as e:
            note_config_problem(e)
            gaps.append(f"could not read where the {b} bot is installed ({e!r})")
            lookup_failed = True
            continue
        if not repos:
            gaps.append(f"the {b} bot is installed on no repositories")
            continue
        installed[b] = repos
    if gaps:
        watch_log("bot inventory is incomplete: " + "; ".join(gaps))
    return {"dry_run": dry_run, "limit": limit, "baseline": baseline, "runs": 0,
            "slugs": {cfg[b]["slug"] + "[bot]": b for b in bots},
            "installed": installed, "gaps": gaps, "lookup_failed": lookup_failed}


RESULT_RANK = ("done", "limit", "later", "failed").index   # for max(): the worst result of several wins


def watch_pr(repo, p, state, seen, ctx):
    """The watcher's decision for one PR. p has number, isDraft and headRefOid, plus state when it comes from
    `gh pr view`. Returns "done" when nothing is left to do on this commit, "limit" when a review only waits
    because this run used up its limit, "later" when a review waits out the retry delay after a failure or needs
    a reviewer bot that is not registered or not installed, and "failed" when the PR could not be read or a
    review failed. With several reviewers the worst one wins."""
    if p["isDraft"] or p.get("state", "OPEN") != "OPEN":
        return "done"
    log, installed = watch_log, ctx["installed"]
    n, sha = p["number"], p["headRefOid"]
    key = f"{repo}#{n}@{sha[:10]}"
    entry = seen[key] = state.get(key, {})
    if ctx["baseline"]:
        entry["baseline"] = True
        log(f"{key}: marked as seen; it will not be reviewed unless new commits arrive")
        return "done"
    if entry.get("baseline"):
        return "done"
    try:
        # labels are read even for a PR skipped before: a label added later, on the same commit, starts its review
        pr = json.loads(gh_read(["pr", "view", str(n), "-R", repo, "--json", "labels,commits"]))
        author, why = detect_author(pr)
        reviewers, _ = choose_reviewers(author, [l["name"] for l in pr["labels"]])
        if not reviewers:
            if not entry.get("skipped"):  # the marker only keeps this line from repeating every pass
                log(f"{key}: skipped, can't tell who wrote it ({why}). Label it agent:claude or "
                    f"agent:codex, or run: prbot review {n} -R {repo} --reviewer claude|codex|both")
            entry["skipped"] = why
            return "done"
        entry.pop("skipped", None)
        todo = [r for r in reviewers if r not in reviewed_by(repo, n, sha, ctx["slugs"])]
    except SystemExit:
        log(f"{key}: could not read the PR; will retry")
        return "failed"
    result, rank = "done", RESULT_RANK
    for r in todo:
        # an unavailable reviewer bot leaves the review owed, so a queue run defers the event instead of dropping it
        if r not in installed:
            log(f"{key}: needs a {r} review, but the {r} bot is not registered or its installations are unknown")
            result = max(result, "later", key=rank)
            continue
        if repo not in installed[r]:
            log(f"{key}: needs a {r} review, but the {r} bot is not installed on {repo}")
            result = max(result, "later", key=rank)
            continue
        if time.time() - entry.get(f"failed_{r}", 0) < RETRY_AFTER:
            result = max(result, "later", key=rank)
            continue
        if ctx["runs"] >= ctx["limit"]:
            log(f"{key}: {r} review waits for the next pass (limit {ctx['limit']} per pass)")
            result = max(result, "limit", key=rank)
            continue
        ctx["runs"] += 1
        if ctx["dry_run"]:
            log(f"{key}: would run a {r} review")
            continue
        log(f"{key}: running a {r} review")
        try:
            cmd_review(str(n), repo, mode="post", only=[r])
        except SystemExit:
            entry[f"failed_{r}"] = time.time()
            log(f"{key}: {r} review failed; retrying in {RETRY_AFTER // 60} minutes")
            result = "failed"
    return result


def watch_repos(repos, state, seen, ctx, skip=()):
    """The full pass over the open PRs of repos, skipping (repo, number) pairs in skip. Returns (outcomes,
    unlisted): the set of every watch_pr result seen, so a caller can test each kind on its own instead of a
    single worst one hiding the rest, and the repositories whose PRs could not be listed."""
    outcomes, unlisted = set(), set()
    for repo in sorted(repos):
        try:
            prs = json.loads(gh_read(["pr", "list", "-R", repo, "--state", "open", "--limit", "100",
                                      "--json", "number,isDraft,headRefOid"]))
        except SystemExit:
            watch_log(f"{repo}: could not list PRs; skipping this pass")
            unlisted.add(repo)
            continue
        for p in prs:
            if (repo, p["number"]) not in skip:
                outcomes.add(watch_pr(repo, p, state, seen, ctx))
    return outcomes, unlisted


def queue_config_problem():
    """The one-line message when the config is bad or unreadable, else None. Other errors still raise."""
    try:
        load_config()
    except (ConfigError, OSError) as e:
        problem = config_problem(e)
        if problem is None:
            raise
        return problem
    return None


def report_queue_config_problem(problem, left):
    print(f"prbot: {problem}", file=sys.stderr)
    watch_log(f"queue: config problem, leaving {left} in the queue: {problem}")


_config_noted = set()


def note_config_problem(e):
    """When a failure caught deep in a watch run is a config problem, print its one line on stderr, once per
    message. The caller still handles the failure as usual (defer and retry)."""
    problem = config_problem(e) if isinstance(e, (ConfigError, OSError)) else None
    if problem is not None and problem not in _config_noted:
        _config_noted.add(problem)
        print(f"prbot: {problem}", file=sys.stderr)


def cmd_watch(dry_run=False, limit=WATCH_LIMIT, baseline=False, queue=None):
    """One pass over open PRs on every repo the bots are installed on. launchd runs this every hour as a backstop
    for the event queue. --baseline marks the commits open right now as seen without reviewing them, so only new
    ones get reviews. With queue, only the PRs named in that event queue directory are handled."""
    # before the lock and before anything moves: a bad config is reported on every run, even one that finds the
    # lock taken, and every queue file stays put. launchd relaunches at most once per ThrottleInterval (60s).
    _config_noted.clear()
    problem = queue_config_problem()
    if problem is not None:
        if queue is not None:
            report_queue_config_problem(problem, "every file")
        else:
            print(f"prbot: {problem}", file=sys.stderr)
        return 2
    # the lock is held from before the queue directory is checked until the last file has moved, so another
    # watch run can't change the queue or the deferred directory between a check and the action it allows
    lock = watch_lock()
    if lock is None:
        watch_log("another watch run holds the lock; " +
                  ("leaving the queue for the next run" if queue is not None else "skipping this pass"))
        return 0
    with lock:
        if queue is not None:
            qdir, why = checked_queue_dir(queue)
            if qdir is None:
                print(f"prbot: refusing --from-queue: {why}. Nothing was moved.", file=sys.stderr)
                return 2
            return cmd_watch_queue(qdir, dry_run, limit, baseline)
        state = load_watch_state(dry_run)
        seen = {}
        ctx = watch_setup(dry_run, limit, baseline)
        _, unlisted = watch_repos(set().union(*ctx["installed"].values()), state, seen, ctx)
        if not dry_run:
            if ctx["gaps"]:  # some repos were never looked at, so nothing can be called closed: merge, don't prune
                state.update(seen)
                seen = state
            else:  # keep entries of repos that could not be listed; prune the rest to PRs still open
                seen.update({k: v for k, v in state.items() if k.split("#", 1)[0] in unlisted and k not in seen})
            save_watch_state(seen)
        runs = ctx["runs"]
        watch_log(f"pass done: {runs} review{'s' if runs != 1 else ''} {'planned' if dry_run else 'run'}")
        code = 2 if ctx["lookup_failed"] else 0
        if not dry_run:
            qdir, why = checked_queue_dir(QUEUE_DIR)
            if qdir is None:  # the pass itself still ran; only the requeue is refused
                print(f"prbot: not moving deferred events back: {why}. Check PRBOT_QUEUE_DIR.", file=sys.stderr)
                return 2
            # still under the lock: a queue job launched by the first file moved back waits for the next relaunch
            requeue_deferred(qdir)
    return code

# ---------- watch --from-queue: handle PRs named in GitHub event files ----------

REPO_NAME = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
QUEUE_DIR = Path(os.environ.get("PRBOT_QUEUE_DIR", Path.home() / ".local/state/github-events/prbot")).expanduser()
MAX_ATTEMPTS = 24        # deferrals before an event file is given up on and rejected
QUEUE_SETTLE = 30        # seconds an unparsable event file is left alone in case it is still being written
CLOCK_SKEW = 300         # an mtime up to this far in the future still counts as just written


DEFAULT_QUEUE_DIR = Path.home() / ".local/state/github-events/prbot"
QUEUE_MARKER = ".github-events-queue"   # a regular file the event router keeps in the queue's parent directory


def checked_queue_dir(qdir):
    """(resolved path, None) when qdir is safe to use as an event queue, else (None, why). A queue run moves
    entries out of the directory, so it must be the default queue or sit next to the router's marker file; the
    marker lives in the parent because anything inside the queue would keep launchd relaunching the job."""
    qdir = Path(qdir).expanduser()
    if os.path.islink(qdir):
        return None, f"{qdir} is a symlink"
    if os.path.lexists(qdir) and not qdir.is_dir():
        return None, f"{qdir} is not a directory"
    real = Path(os.path.realpath(qdir))
    try:
        marked = stat.S_ISREG(os.lstat(real.parent / QUEUE_MARKER).st_mode)
    except OSError:
        marked = False
    if real != Path(os.path.realpath(DEFAULT_QUEUE_DIR)) and not marked:
        return None, (f"{qdir} is not {DEFAULT_QUEUE_DIR} and its parent has no {QUEUE_MARKER} file, "
                      f"so it does not look like a GitHub event queue")
    for kind in ("deferred", "rejected"):  # files are moved into these, so they must not lead anywhere else
        side = queue_sibling(real, kind)
        try:
            mode = os.lstat(side).st_mode
        except FileNotFoundError:
            continue
        if not stat.S_ISDIR(mode):
            return None, f"{side} exists but is not a directory (a symlink or a file)"
    return real, None


def queue_sibling(qdir, kind):
    """<parent>/<name>-deferred or -rejected. Outside the queue directory, so launchd does not see them."""
    return qdir.parent / f"{qdir.name}-{kind}"


def queue_entries(qdir):
    """(event files, other entries) in qdir, oldest first; names start with a UTC timestamp, so name order is
    arrival order. Event files are regular .json files whose name does not start with a dot. Everything else
    (dotfiles, other names, subdirectories, symlinks) is another entry, judged with lstat so a symlink is never
    followed. A missing directory has neither. Only call this on a directory checked_queue_dir accepted."""
    try:
        names = sorted(os.listdir(qdir))
    except (FileNotFoundError, NotADirectoryError):
        return [], []
    files, other = [], []
    for n in names:
        p = qdir / n
        try:
            mode = os.lstat(p).st_mode
        except FileNotFoundError:
            continue
        ok = stat.S_ISREG(mode) and n.endswith(".json") and not n.startswith(".")
        (files if ok else other).append(p)
    return files, other


def move_into(path, dest, data=None):
    """Move path into directory dest, adding -1, -2... to the name on a collision. With data, the moved file is
    then rewritten as that JSON in place, atomically. Moving first means the event is in exactly one place at
    every moment: if the rewrite fails, it sits in dest unchanged rather than in both directories."""
    dest.mkdir(parents=True, exist_ok=True)
    stem, suffix = (path.stem, path.suffix) if path.suffix == ".json" else (path.name, "")
    target, i = dest / path.name, 0
    while os.path.lexists(target):
        i += 1
        target = dest / f"{stem}-{i}{suffix}"
    os.replace(path, target)
    if data is not None:
        try:
            write_json_atomic(target, data, indent=1)
        except OSError as e:
            watch_log(f"queue: moved {path.name} to {dest} but could not update it ({e}); it keeps its old content")
    return target


def requeue_deferred(qdir):
    """Move every deferred event file back into the queue, so the queue job checks those PRs again."""
    files = queue_entries(queue_sibling(qdir, "deferred"))[0]
    for p in files:
        move_into(p, qdir)
    if files:
        watch_log(f"queue: moved {len(files)} deferred event file{'s' if len(files) != 1 else ''} back to {qdir}")


def parse_queue_event(path):
    """("pull_request", repo, number) or ("sweep", repo or None, None) from one event file, or None when it is
    JSON but neither a pull_request event with a valid repo and number nor a sweep whose repo is a valid name or
    null. Raises ValueError when the file is not JSON at all, which may mean it is still being written."""
    ev = json.loads(path.read_text())
    if not isinstance(ev, dict):
        return None
    repo = ev.get("repo")
    if ev.get("kind") == "sweep":  # the router could not tell which PR: rescan repo, or every repo when null
        return ("sweep", repo, None) if repo is None or (isinstance(repo, str) and REPO_NAME.match(repo)) else None
    if ev.get("kind") != "pull_request" or not isinstance(repo, str) or not REPO_NAME.match(repo):
        return None
    n = ev.get("number")
    if isinstance(n, bool) or not isinstance(n, int) or n < 1:
        return None
    return "pull_request", repo, n


def cmd_watch_queue(qdir, dry_run=False, limit=WATCH_LIMIT, baseline=False):
    """Handle each PR named in the event queue once, with the same decisions as a full pass. launchd relaunches
    the job for as long as the directory has anything in it, so only PRs held back by this run's limit stay (each
    run reviews at least one PR, so a burst drains a run at a time). A PR's files are deleted when nothing is
    left to do on it, moved to <queue>-deferred (with an attempts count) when a review fails or waits out the
    retry delay, and anything that can never be handled is moved to <queue>-rejected. The hourly full pass
    moves the deferred files back. Returns 2 if any PR failed or the repository lookup failed. The caller holds
    the watch lock and has already checked qdir with checked_queue_dir."""
    problem = queue_config_problem()  # cmd_watch checked already; this covers a direct call
    if problem is not None:
        report_queue_config_problem(problem, "every file")
        return 2
    if not any(queue_entries(qdir)):
        return 0
    rejected, deferred = queue_sibling(qdir, "rejected"), queue_sibling(qdir, "deferred")

    def act(verb, path, why, fn):
        watch_log(f"queue: {'would ' + verb if dry_run else verb} {path.name}: {why}")
        if not dry_run:
            try:
                fn()
            except FileNotFoundError:
                pass

    def reject(path, why):
        act(f"move to {rejected}", path, why, lambda: move_into(path, rejected))

    def defer(path, why):
        try:
            ev = json.loads(path.read_text())
        except FileNotFoundError:
            return
        attempts = ev.get("attempts", 0)
        if isinstance(attempts, bool) or not isinstance(attempts, int) or attempts < 0:
            # a negative count would put off rejection almost forever; anything but a whole number >= 0 is invalid
            watch_log(f"queue: {path.name} has an invalid attempts value {attempts!r}; counting from 0")
            attempts = 0
        ev["attempts"] = attempts + 1
        if ev["attempts"] >= MAX_ATTEMPTS:
            act(f"move to {rejected}", path, f"{why}; giving up after {ev['attempts']} attempts",
                lambda: move_into(path, rejected, ev))
        else:
            act(f"move to {deferred}", path, f"{why}; attempt {ev['attempts']}", lambda: move_into(path, deferred, ev))

    files, unsupported = queue_entries(qdir)
    for path in unsupported:  # os.replace moves the entry itself: a directory whole, a symlink as a link
        kind = "a directory" if os.path.isdir(path) and not os.path.islink(path) else "not an event file"
        reject(path, kind)
    events, sweeps = [], []
    for path in files:
        try:
            ev = parse_queue_event(path)
        except FileNotFoundError:
            continue
        except ValueError:
            try:
                age = time.time() - path.stat().st_mtime
            except FileNotFoundError:
                continue
            # may still be mid-write; ThrottleInterval (60s) brings the next run after it settles. An mtime
            # further ahead than clock skew explains counts as settled, so it can't hold the queue open for long.
            if -CLOCK_SKEW <= age < QUEUE_SETTLE:
                watch_log(f"queue: leaving {path.name} for now: not valid JSON yet, written {age:.0f}s ago")
                continue
            reject(path, f"not valid JSON, written {age:.0f}s ago")
            continue
        if ev is None:
            reject(path, "not a pull_request event with a valid repo and number, nor a sweep")
        else:
            (sweeps if ev[0] == "sweep" else events).append((path, ev))
    if not events and not sweeps:
        return 0
    try:
        # at least one review per run, so files held back by the limit drain one launchd relaunch at a time
        ctx = watch_setup(dry_run, max(limit, 1), baseline)
    except (SystemExit, Exception) as e:  # can't tell which repos are covered: retry later, never reject
        problem = config_problem(e) if isinstance(e, (ConfigError, OSError)) else None
        if problem is not None:
            # the config broke after the check at the start: say why on stderr, then retry like any lookup failure
            note_config_problem(e)
            watch_log(f"queue: config problem during the run, deferring the event files: {problem}")
        else:
            watch_log(f"queue: could not look up the repositories the bots are installed on ({e!r})")
        for path, _ in events + sweeps:
            defer(path, "repository lookup failed")
        return 2
    covered = {r.lower(): r for r in set().union(*ctx["installed"].values())}
    complete = not ctx["gaps"]  # only a full inventory of every bot can call a repository unknown
    failed = 1 if ctx["lookup_failed"] else 0
    uncovered = 0

    def not_covered(path, repo, label=""):
        nonlocal uncovered
        if complete:
            reject(path, f"{label}{repo}: {repo} is not a repository the bots are installed on")
        else:
            uncovered += 1
            defer(path, f"{label}{repo}: {repo} is not in the bot inventory, which is incomplete")

    groups = {}
    for path, (_, repo, n) in events:
        if repo.lower() not in covered:
            not_covered(path, repo, "event for ")
        else:
            groups.setdefault((covered[repo.lower()], n), []).append(path)
    sweep_paths, sweep_repos = [], set()  # None in sweep_repos means every covered repository
    for path, (_, repo, _) in sweeps:
        if repo is not None and repo.lower() not in covered:
            not_covered(path, repo, "sweep of ")
            continue
        sweep_paths.append(path)
        sweep_repos.add(covered[repo.lower()] if repo is not None else None)
    if uncovered and not failed:
        failed = 1  # events can't be placed until the configuration is fixed: say so with the exit code
    state = load_watch_state(dry_run)
    seen = {}
    for (repo, n), paths in groups.items():
        try:
            p = json.loads(gh_read(["pr", "view", str(n), "-R", repo, "--json",
                                    "number,state,isDraft,headRefOid"]))
            result = watch_pr(repo, p, state, seen, ctx)
        except (SystemExit, Exception) as e:
            note_config_problem(e)
            watch_log(f"{repo}#{n}: could not handle the PR ({e!r})")
            result = "failed"
        if result == "limit":  # untouched: launchd starts another run after ThrottleInterval
            watch_log(f"{repo}#{n}: over this run's limit; leaving {len(paths)} file"
                      f"{'s' if len(paths) != 1 else ''} in the queue for the next run")
            continue
        for path in paths:
            if result == "done":
                act("delete", path, f"{repo}#{n} handled", path.unlink)
            else:
                defer(path, f"{repo}#{n} {'failed' if result == 'failed' else 'has to wait'}")
        failed += result == "failed"
    if sweep_paths:  # after the PR events, which are more precise; PRs they just handled are skipped
        repos = set(covered.values()) if None in sweep_repos else sweep_repos
        watch_log(f"queue: sweep of {'every covered repository' if None in sweep_repos else ', '.join(sorted(repos))}")
        try:
            outcomes, unlisted = watch_repos(repos, state, seen, ctx, skip=set(groups))
        except (SystemExit, Exception) as e:
            note_config_problem(e)
            watch_log(f"queue: sweep failed ({e!r})")
            outcomes, unlisted = {"failed"}, set()
        # each outcome is checked on its own, so one PR's success or wait can't hide another PR's limit block.
        # Retry-delay waits and unavailable bots are owned by the hourly pass, so they don't hold the sweep.
        sweep_failed = "failed" in outcomes or bool(unlisted)
        if None in sweep_repos and not complete:
            watch_log("queue: sweep could not reach repositories missing from the incomplete bot inventory")
            sweep_failed = True
        failed += sweep_failed
        if "limit" in outcomes:  # a review ran this run, so leaving the sweep in place still makes progress
            watch_log("queue: sweep is over this run's limit; leaving it in the queue for the next run")
        elif sweep_failed:
            for path in sweep_paths:
                defer(path, "sweep failed or was incomplete")
        else:
            for path in sweep_paths:  # only the files listed at the start; a sweep written since waits its turn
                act("delete", path, "sweep done", path.unlink)
    if not dry_run:
        state.update(seen)  # unlike a full pass, a queue run sees only some PRs, so it must not prune the rest
        save_watch_state(state)
    runs = ctx["runs"]
    watch_log(f"queue done: {len(groups)} PR{'s' if len(groups) != 1 else ''}, {runs} review"
              f"{'s' if runs != 1 else ''} {'planned' if dry_run else 'run'}, {failed} failed")
    return 2 if failed else 0

# ---------- commands ----------


def die(msg, code=2):
    print(f"prbot: {msg}", file=sys.stderr)
    sys.exit(code)


def load_bot_spec(bot, spec_path=None):
    """A bot spec from bots/<bot>.json, or from another repo with --spec. Its logo path is relative to the spec."""
    path = Path(spec_path).expanduser().resolve() if spec_path else ROOT / "bots" / f"{bot}.json"
    if not path.exists():
        die(f"unknown bot '{bot}' (no {path})")
    spec = json.loads(path.read_text())
    spec["logo_path"] = str(path.parent / spec["logo"]) if spec.get("logo") else None
    return spec


def manifest(spec, redirect_url):
    """App manifest. A spec may set its own permissions (workers need contents write); metadata read is required."""
    return {
        "name": spec["name"],
        "url": spec["url"],
        "description": spec["description"],
        "public": False,
        "redirect_url": redirect_url,
        "hook_attributes": {"url": spec["url"], "active": False},
        "default_permissions": {**spec.get("permissions", PERMISSIONS), "metadata": "read"},
        "default_events": [],
    }


def cmd_register(bot, org=None, spec_path=None):
    """GitHub App manifest flow: a local page posts the manifest, GitHub redirects back with a one-hour code."""
    load_config()  # a broken config stops here, before the local server starts or GitHub creates an App
    spec =load_bot_spec(bot, spec_path)
    state = secrets.token_urlsafe(16)
    result = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _send(self, body, status=200):
            self.send_response(status)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(body.encode())

        def do_GET(self):
            url = urllib.parse.urlparse(self.path)
            q = urllib.parse.parse_qs(url.query)
            if url.path == "/":
                redirect = f"http://127.0.0.1:{self.server.server_address[1]}/callback"
                target = (f"https://github.com/organizations/{org}/settings/apps/new" if org
                          else "https://github.com/settings/apps/new") + f"?state={state}"
                m = html.escape(json.dumps(manifest(spec, redirect)), quote=True)
                self._send(f'<form id="f" method="post" action="{target}"><input type="hidden" name="manifest" '
                           f'value="{m}"><p>Creating GitHub App <b>{html.escape(spec["name"])}</b>.</p>'
                           f'<button>Continue to GitHub</button></form><script>f.submit()</script>')
            elif url.path == "/callback":
                if q.get("state", [""])[0] != state or "code" not in q:
                    self._send("State mismatch or missing code. Start again with prbot register.", 400)
                    return
                app = api("POST", f"/app-manifests/{q['code'][0]}/conversions")
                where = store_key(bot, app["pem"])
                cfg = load_config()
                cfg[bot] = {"app_id": app["id"], "slug": app["slug"], "client_id": app.get("client_id"),
                            "owner": app["owner"]["login"]}
                save_config(cfg)
                result.update(slug=app["slug"], where=where)
                install = f"https://github.com/apps/{app['slug']}/installations/new"
                self._send(f"<p>Created <b>{html.escape(app['slug'])}</b>. Private key stored in {html.escape(where)}.</p>"
                           f'<p>Next: <a href="{install}">install it on your repos</a>, then upload '
                           f"<code>{html.escape(spec['logo_path'] or 'the logo')}</code> under the App's Display information.</p>")
            else:
                self._send("not found", 404)

    srv = http.server.HTTPServer(("127.0.0.1", 0), Handler)
    print(f"Open this in your browser to create the {spec['name']} App:\n  http://127.0.0.1:{srv.server_address[1]}/")
    while not result:
        srv.handle_request()
    print(f"Registered {result['slug']}. Key stored in {result['where']}.")
    print(f"Install it:      https://github.com/apps/{result['slug']}/installations/new")
    print(f"Upload the logo: https://github.com/settings/apps/{result['slug']}  ({spec['logo_path']})")


SHIM_DIR = ROOT / "integrations" / "codex" / "bin"


def _same_file(a, b):
    """True when a and b name the same file or directory (same device and inode); False if either is missing."""
    try:
        return os.path.samefile(a, b)
    except (OSError, ValueError):
        return False


def _path_without_shims():
    return os.pathsep.join(p for p in os.environ.get("PATH", "").split(os.pathsep) if not _same_file(p or ".", SHIM_DIR))


def split_gh_args(args):
    """prbot's own options come before '--' ('-R owner/repo'); everything after it goes to gh unchanged."""
    if "--" not in args:
        return None, args
    i = args.index("--")
    return repo_from_args(args[:i]), args[i + 1:]


def bot_identity(bot):
    """(name, email) that make GitHub show a commit as the bot, with its logo. The id is looked up once."""
    cfg = load_config()
    slug = bot_config(bot)["slug"]
    if not cfg[bot].get("user_id"):
        cfg[bot]["user_id"] = json.loads(gh_read(["api", f"users/{slug}%5Bbot%5D"]))["id"]
        save_config(cfg)
    return f"{slug}[bot]", f"{cfg[bot]['user_id']}+{slug}[bot]@users.noreply.github.com"


def git_env(token=None, identity=None):
    """Environment for git as the bot. identity sets author and committer. token, when given, is the only
    credential git uses for github.com; the helper reads it from the environment, so it never reaches disk."""
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    env.pop("GITHUB_TOKEN", None)
    if identity:
        env["GIT_AUTHOR_NAME"] = env["GIT_COMMITTER_NAME"] = identity[0]
        env["GIT_AUTHOR_EMAIL"] = env["GIT_COMMITTER_EMAIL"] = identity[1]
    if token:
        helper = '!f() { echo username=x-access-token; echo "password=$PRBOT_GIT_TOKEN"; }; f'
        pairs = [("credential.helper", ""), ("credential.https://github.com.helper", ""),
                 ("credential.https://github.com.helper", helper)]
        env.update(PRBOT_GIT_TOKEN=token, GIT_CONFIG_COUNT=str(len(pairs)))
        for i, (k, v) in enumerate(pairs):
            env[f"GIT_CONFIG_KEY_{i}"], env[f"GIT_CONFIG_VALUE_{i}"] = k, v
    return env


REMOTE_SUBCOMMANDS = ("push", "fetch", "pull")


# git's own options that take their value as the next word
GIT_VALUE_OPTIONS = ("-C", "-c", "--git-dir", "--work-tree", "--namespace", "--super-prefix", "--config-env",
                     "--attr-source")


def git_subcommand(args):
    """(index, name) of git's subcommand, skipping git's own options such as -C <dir>, -c k=v and --git-dir <dir>."""
    i = 0
    while i < len(args) and args[i].startswith("-"):
        i += 2 if args[i] in GIT_VALUE_OPTIONS else 1
    return (i, args[i]) if i < len(args) else (len(args), None)


def cmd_git(bot, args, repo=None):
    """Run git as the bot. Commits get the bot as author and committer; push, fetch and pull get a
    one-hour token with contents write for this repo only."""
    at, sub = git_subcommand(args)
    if sub not in REMOTE_SUBCOMMANDS:
        os.execvpe("git", ["git"] + args, git_env(identity=bot_identity(bot)))
    if not repo:
        remote = next((a for a in args[at + 1:] if not a.startswith("-")), "origin")
        # args[:at] keeps git's own options such as -C <dir>, so the lookup runs where the push would
        r = subprocess.run(["git"] + args[:at] + ["remote", "get-url", remote], capture_output=True, text=True)
        m = re.search(r"github\.com[:/]([^/]+)/([^/\s]+?)(\.git)?\s*$", r.stdout) if r.returncode == 0 else None
        repo = f"{m.group(1)}/{m.group(2)}" if m else None
    if not repo:
        die("cannot tell which GitHub repository this pushes to; pass -R owner/repo")
    env = git_env(installation_token(bot, repo, permissions={"contents": "write"}), bot_identity(bot))
    os.execvpe("git", ["git"] + args, env)


def cmd_gh(bot, args, repo=None):
    repo = repo or repo_from_args(args) or repo_from_git()
    if not repo:
        die("cannot tell which repository this is for; pass -R owner/repo")
    gh = _real_gh()  # before the token: a PRBOT_REAL_GH that loops back through the shim is refused first
    env = dict(os.environ, GH_TOKEN=installation_token(bot, repo), PRBOT_ACTIVE=bot)
    env.pop("GITHUB_TOKEN", None)
    os.execve(gh, [gh] + args, env)


def _classify(rest):
    """Print write or read for a gh argv. Exit 0 for write, 1 for read, 4 when it can't decide or the call is off
    the safe list. After `--` the argv is exactly what gh receives, so a first word `gh` is a command name (an alias
    or an extension) and is kept; without `--` a leading `gh` is dropped."""
    if rest[:1] == ["--"]:
        args = rest[1:]
    else:
        args = rest[1:] if rest[:1] == ["gh"] else rest
    try:
        cfg = load_config()
        write = classify_gh(args, cfg.get("codex_triggers_as_bot", False))
    except (ConfigError, Undecided) as e:
        print(f"prbot classify: {e}", file=sys.stderr)
        return 4
    except Exception as e:
        print(f"prbot classify: cannot decide ({type(e).__name__}: {e})", file=sys.stderr)
        return 4
    print("write" if write else "read")
    return 0 if write else 1


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == "classify":
        return _classify(rest)
    try:
        if cmd in ("watch", "review"):
            review_timeout()  # a bad PRBOT_REVIEW_TIMEOUT stops here with a clear message, before any work
        if cmd == "watch":
            limit = WATCH_LIMIT
            if "--limit" in rest:
                limit = int(rest[rest.index("--limit") + 1])
            queue = None
            if "--from-queue" in rest:
                i = rest.index("--from-queue")
                if i + 1 >= len(rest) or rest[i + 1].startswith("-"):
                    die("usage: prbot watch --from-queue DIR [--dry-run] [--limit N] [--baseline]")
                queue = rest[i + 1]
            return cmd_watch(dry_run="--dry-run" in rest, limit=limit, baseline="--baseline" in rest, queue=queue)
        if cmd == "review":
            opts = {"-R": None, "--repo": None, "--reviewer": None}
            flags, target, i = set(), None, 0
            while i < len(rest):
                a = rest[i]
                if a in opts and i + 1 < len(rest):
                    opts[a] = rest[i + 1]
                    i += 2
                    continue
                if a in ("--dry-run", "--route-only"):
                    flags.add(a)
                elif not a.startswith("-") and target is None:
                    target = a
                else:
                    die(f"review: unexpected argument '{a}'")
                i += 1
            if not target:
                die("usage: prbot review <pr-number|url> [-R owner/repo] [--reviewer claude|codex|both] "
                    "[--dry-run|--route-only]")
            if opts["--reviewer"] not in (None, "claude", "codex", "both"):
                die("--reviewer must be claude, codex or both")
            mode = "route" if "--route-only" in flags else "dry-run" if "--dry-run" in flags else "post"
            return cmd_review(target, opts["-R"] or opts["--repo"], opts["--reviewer"], mode)
        if not rest:
            die(f"{cmd}: missing bot name")
        bot = rest[0]
        if cmd == "register":
            cmd_register(bot, rest[rest.index("--org") + 1] if "--org" in rest else None,
                         rest[rest.index("--spec") + 1] if "--spec" in rest else None)
        elif cmd == "import-key":
            cfg = load_config()
            if bot not in cfg:
                if len(rest) < 4:
                    die("first import needs: prbot import-key <bot> <pem> <app_id> <owner>")
                cfg[bot] = {"app_id": int(rest[2]), "owner": rest[3]}
                save_config(cfg)
            print("stored in", store_key(bot, Path(rest[1]).read_text()))
        elif cmd == "install-url":
            print(f"https://github.com/apps/{bot_config(bot)['slug']}/installations/new")
        elif cmd == "whoami":
            cfg = bot_config(bot)
            jwt = app_jwt(cfg.get("client_id") or cfg["app_id"], read_key(bot))
            app = api("GET", "/app", auth=jwt)
            print(f"{app['slug']}[bot]  app_id={app['id']}  owner={app['owner']['login']}")
            for i in api("GET", "/app/installations", auth=jwt):
                print(f"  installed on {i['account']['login']} ({i['repository_selection']} repos)")
        elif cmd == "gh":
            repo, args = split_gh_args(rest[1:])
            cmd_gh(bot, args, repo)
        elif cmd == "git":
            repo, args = split_gh_args(rest[1:])
            cmd_git(bot, args, repo)
        else:
            die(f"unknown command '{cmd}'")
        return 0
    except (ConfigError, OSError) as e:
        problem = config_problem(e)
        if problem is None:
            raise
        print(f"prbot: {problem}", file=sys.stderr)
        return 2


def config_problem(e):
    """The one-line message for a bad or unreadable config, or None when e is about something else.

    load_config lets read errors through so the guard hook can name them; only the config's own are turned into
    a message here. The raw OS error text is never shown, only a fixed reason."""
    if isinstance(e, ConfigError):
        return str(e)
    if not isinstance(e, OSError) or e.filename is None or Path(e.filename) != CONFIG:
        return None
    if isinstance(e, IsADirectoryError):
        reason = "the path is a directory, not a file"
    elif isinstance(e, PermissionError):
        reason = "permission denied; check the file's mode and owner"
    else:
        reason = "the file could not be read"
    return f"{CONFIG}: cannot read ({type(e).__name__}: {reason}); fix or remove it"


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
