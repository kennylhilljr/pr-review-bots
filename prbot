#!/usr/bin/env python3
"""prbot: post PR feedback as a GitHub App bot instead of your own account.

  prbot register <bot> [--org ORG] [--spec FILE]
                                     create the GitHub App from bots/<bot>.json, or from FILE
  prbot import-key <bot> <pem> [<app_id> <owner>]
                                     store (or rotate) the App private key
  prbot install-url <bot>            print the page that installs the App on repos
  prbot whoami <bot>                 show the App and where it is installed
  prbot gh <bot> [-R owner/repo] -- <gh args>
                                     run gh with a one-repo installation token
  prbot git <bot> [-R owner/repo] -- <git args>
                                     run git (push) as the bot with a one-repo contents-write token
  prbot review <pr> [-R owner/repo] [--reviewer claude|codex|both] [--dry-run|--route-only]
                                     review a PR with the other agent and post it as that agent's bot;
                                     exits 3 and asks when it can't tell who wrote the PR
  prbot watch [--dry-run] [--limit N] [--baseline]
                                     one pass: review new commits on open, non-draft PRs on every repo
                                     the bots are installed on (launchd runs it every 5 minutes)
  prbot classify -- <gh args>        exit 0 if the gh call writes PR feedback

Standard library plus the openssl and gh binaries. No token is printed or saved.
"""
import base64, html, http.server, json, os, re, secrets, shlex, shutil, ssl, subprocess, sys, tempfile, time
import urllib.error, urllib.parse, urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent
CONFIG_DIR = Path(os.environ.get("PRBOT_CONFIG_DIR", Path.home() / ".config" / "prbot"))
CONFIG = CONFIG_DIR / "config.json"
API = "https://api.github.com"
KEYCHAIN_SERVICE = "prbot"
PERMISSIONS = {"pull_requests": "write", "issues": "write", "contents": "read", "metadata": "read"}

# ---------- classification: which gh calls write PR feedback ----------

WRITE_SUBCOMMANDS = {("pr", "review"), ("pr", "comment"), ("issue", "comment")}
FEEDBACK_PATH = re.compile(r"/(comments|reviews|replies)(/|$|\?)|/reviews/\d+/(events|dismissals)")
FEEDBACK_MUTATION = re.compile(r"\b(addPullRequestReview\w*|submitPullRequestReview|addComment|updateIssueComment|"
                               r"updatePullRequestReview\w*|resolveReviewThread|unresolveReviewThread)\b")
FIELD_FLAGS = ("-f", "-F", "--field", "--raw-field", "--input")


def _body_arg(args):
    for i, a in enumerate(args):
        if a in ("-b", "--body") and i + 1 < len(args):
            return args[i + 1]
        if a.startswith("--body="):
            return a.split("=", 1)[1]
    return None


def is_feedback_write(args, codex_triggers_as_bot=False):
    """args: the gh argv without the leading 'gh'."""
    if len(args) >= 2 and (args[0], args[1]) in WRITE_SUBCOMMANDS:
        body = _body_arg(args)
        if body is not None and body.lstrip().startswith("@codex") and not codex_triggers_as_bot:
            return False  # Codex Cloud triggers stay on the human account until tested
        return True
    if args[:1] == ["api"]:
        rest = args[1:]
        method = None
        for i, a in enumerate(rest):
            if a in ("-X", "--method") and i + 1 < len(rest):
                method = rest[i + 1].upper()
            elif a.startswith("--method="):
                method = a.split("=", 1)[1].upper()
        has_fields = any(a in FIELD_FLAGS or (a.startswith("--") and a.split("=", 1)[0] in FIELD_FLAGS) for a in rest)
        if not (method in ("POST", "PATCH", "PUT", "DELETE") or (method is None and has_fields)):
            return False
        positional = [a for a in rest if not a.startswith("-")]
        if any(p.rstrip("/").endswith("graphql") for p in positional):
            return any(FEEDBACK_MUTATION.search(a) for a in rest)
        return any(FEEDBACK_PATH.search(p) for p in positional)
    return False


def _commands(command):
    """Yield (program, argv) for each simple command in a shell command string, skipping VAR=... and wrappers."""
    lex = shlex.shlex(command, posix=True, punctuation_chars=";&|()")
    lex.whitespace_split = True
    lex.commenters = ""
    try:
        tokens = list(lex)
    except ValueError:  # unbalanced quotes: fall back to a rough split rather than letting the call through
        tokens = command.split()
    seg = []
    for tok in tokens + [";"]:
        if tok and set(tok) <= set(";&|()\n"):
            i = 0
            while i < len(seg) and (re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", seg[i]) or seg[i] in ("command", "exec", "env", "time")):
                i += 1
            if i < len(seg):
                yield os.path.basename(seg[i]), seg[i + 1:]
            seg = []
        else:
            seg.append(tok)


def gh_calls(command):
    """Yield (argv_after_gh, routed_through_prbot) for each gh or prbot call in a shell command string."""
    for prog, args in _commands(command):
        if prog in ("gh", "prbot"):
            yield args, prog == "prbot"


GUARDED_GIT = ("commit", "push")


def git_writes(command):
    """(argv_after_git, -C dir or None) for each plain `git commit` or `git push` in a shell command string."""
    for prog, args in _commands(command):
        if prog != "git":
            continue
        _, sub = git_subcommand(args)
        if sub in GUARDED_GIT:
            cdir = args[args.index("-C") + 1] if "-C" in args[:args.index(sub)] else None
            yield args, cdir


def unrouted_writes(command, codex_triggers_as_bot=False):
    """gh argv lists in a shell command that write PR feedback without going through prbot."""
    return [args for args, routed in gh_calls(command)
            if not routed and is_feedback_write(args, codex_triggers_as_bot)]

# ---------- config and key storage ----------


def load_config():
    return json.loads(CONFIG.read_text()) if CONFIG.exists() else {}


def save_config(cfg):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(json.dumps(cfg, indent=2) + "\n")


def bot_config(bot):
    cfg = load_config().get(bot)
    if not cfg:
        die(f"bot '{bot}' is not registered. Run: prbot register {bot}")
    return cfg


def _keychain():
    return shutil.which("security") and os.environ.get("PRBOT_KEY_STORE") != "file"


def store_key(bot, pem):
    if _keychain():
        enc = base64.b64encode(pem.encode()).decode()  # base64 so the multi-line PEM round-trips through -w
        subprocess.run(["security", "add-generic-password", "-U", "-s", KEYCHAIN_SERVICE, "-a", bot, "-w", enc],
                       check=True, capture_output=True)
        return f"macOS Keychain (service {KEYCHAIN_SERVICE}, account {bot})"
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    path = CONFIG_DIR / f"{bot}.pem"
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(pem)
    return str(path)


def read_key(bot):
    if _keychain():
        r = subprocess.run(["security", "find-generic-password", "-s", KEYCHAIN_SERVICE, "-a", bot, "-w"],
                           capture_output=True, text=True)
        if r.returncode == 0:
            return base64.b64decode(r.stdout.strip()).decode()
    path = CONFIG_DIR / f"{bot}.pem"
    if path.exists():
        return path.read_text()
    die(f"no private key for '{bot}'. Run: prbot import-key {bot} <file.pem>")

# ---------- GitHub API ----------


def _ssl_context():
    ctx = ssl.create_default_context()
    if ctx.cert_store_stats().get("x509_ca", 0) == 0:  # python.org builds on macOS ship no CA store
        for cafile in ("/etc/ssl/cert.pem", "/opt/homebrew/etc/openssl@3/cert.pem", "/usr/local/etc/openssl@3/cert.pem"):
            if os.path.exists(cafile):
                ctx.load_verify_locations(cafile)
                break
    return ctx


def api(method, path, auth=None, body=None):
    req = urllib.request.Request(API + path, method=method, data=json.dumps(body).encode() if body is not None else None)
    req.add_header("Accept", "application/vnd.github+json")
    req.add_header("X-GitHub-Api-Version", "2022-11-28")
    req.add_header("User-Agent", "prbot")
    if auth:
        req.add_header("Authorization", "Bearer " + auth)
    try:
        with urllib.request.urlopen(req, context=_ssl_context(), timeout=30) as r:
            return json.loads(r.read() or b"null")
    except urllib.error.HTTPError as e:
        die(f"GitHub {method} {path} failed: HTTP {e.code} {e.read().decode(errors='replace')[:300]}")


def b64url(data):
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()


def app_jwt(issuer, pem, now=None):
    """RS256 JWT for the App, valid 9 minutes (GitHub allows up to 10). Signed with openssl."""
    now = int(now if now is not None else time.time())
    header = b64url(json.dumps({"alg": "RS256", "typ": "JWT"}, separators=(",", ":")).encode())
    payload = b64url(json.dumps({"iat": now - 60, "exp": now + 540, "iss": str(issuer)}, separators=(",", ":")).encode())
    signing_input = f"{header}.{payload}".encode()
    fd, keyfile = tempfile.mkstemp(prefix="prbot-", suffix=".pem")  # mkstemp creates it 0600
    try:
        with os.fdopen(fd, "w") as f:
            f.write(pem)
        sig = subprocess.run(["openssl", "dgst", "-sha256", "-sign", keyfile], input=signing_input,
                             capture_output=True, check=True).stdout
    finally:
        os.unlink(keyfile)
    return f"{header}.{payload}.{b64url(sig)}"


def installation_token(bot, repo, permissions=None):
    """One-hour token for one repo. Posting needs the default set; pushing asks for {"contents": "write"}."""
    cfg = bot_config(bot)
    jwt = app_jwt(cfg.get("client_id") or cfg["app_id"], read_key(bot))
    owner, name = repo.split("/", 1)
    inst = api("GET", f"/repos/{owner}/{name}/installation", auth=jwt)
    perms = permissions or {k: v for k, v in PERMISSIONS.items() if k != "metadata"}
    tok = api("POST", f"/app/installations/{inst['id']}/access_tokens", auth=jwt,
              body={"repositories": [name], "permissions": perms})
    return tok["token"]

# ---------- repo resolution ----------


def repo_from_args(args):
    for i, a in enumerate(args):
        if a in ("-R", "--repo") and i + 1 < len(args):
            return args[i + 1]
        if a.startswith("--repo="):
            return a.split("=", 1)[1]
    for a in args:
        m = re.match(r"^/?repos/([^/]+)/([^/?]+)", a) or re.match(r"^https://github\.com/([^/]+)/([^/]+)/(pull|issues)/\d+", a)
        if m:
            return f"{m.group(1)}/{m.group(2)}"
    return None


def repo_from_git(cwd=None):
    r = subprocess.run(["git", "remote", "get-url", "origin"], capture_output=True, text=True, cwd=cwd)
    m = re.search(r"github\.com[:/]([^/]+)/([^/\s]+?)(\.git)?\s*$", r.stdout) if r.returncode == 0 else None
    return f"{m.group(1)}/{m.group(2)}" if m else None

# ---------- review routing: the other agent reviews, unless told otherwise ----------

AGENTS = ("claude", "codex")
AGENT_IDS = {
    # review bots (claude-pr-gh, codex-pr-gh) and issue worker bots (claude-dev-gh, codex-dev-gh)
    "claude": {"logins": {"claude", "claude[bot]", "claude-pr-gh[bot]", "claude-dev-gh[bot]"},
               "emails": {"noreply@anthropic.com"}},
    "codex": {"logins": {"codex", "codex-pr-gh[bot]", "codex-dev-gh[bot]", "chatgpt-codex-connector[bot]"},
              "emails": {"codex@openai.com"}},
}
CO_AUTHOR = re.compile(r"(?im)^co-authored-by:.*<([^>]+)>")


def agent_of(login="", email=""):
    login, email = (login or "").lower(), (email or "").lower()
    for agent, ids in AGENT_IDS.items():
        if login in ids["logins"] or email in ids["emails"]:
            return agent
        # bot commit emails look like 349557468+claude-pr-gh[bot]@users.noreply.github.com
        if any(email.endswith(f"+{l}@users.noreply.github.com") for l in ids["logins"] if l.endswith("[bot]")):
            return agent
    return None


def detect_author(pr):
    """(agent or None, reason) from `gh pr view --json labels,commits`. Labels win; then commit authors and
    Co-Authored-By trailers. Human co-authors are ignored; both agents, or neither, means unclear."""
    labels = {l["name"].lower() for l in pr.get("labels", [])}
    tagged = [a for a in AGENTS if f"agent:{a}" in labels]
    if len(tagged) == 1:
        return tagged[0], f"label agent:{tagged[0]}"
    if tagged:
        return None, "it has both agent:claude and agent:codex labels"
    seen = set()
    for c in pr.get("commits", []):
        for a in c.get("authors", []):
            seen.add(agent_of(a.get("login"), a.get("email")))
        for email in CO_AUTHOR.findall(c.get("messageBody") or ""):
            seen.add(agent_of(email=email))
    seen.discard(None)
    if len(seen) == 1:
        agent = seen.pop()
        return agent, f"commits by {agent}"
    if seen:
        return None, "it has commits by both claude and codex"
    return None, "it has no agent label and no claude or codex commits"


def choose_reviewers(author, labels, override=None):
    """(reviewers, reason). An explicit --reviewer or review:* label wins; otherwise the other agent reviews."""
    if override:
        return (list(AGENTS) if override == "both" else [override]), f"requested with --reviewer {override}"
    labels = {l.lower() for l in labels}
    asked = [a for a in AGENTS if f"review:{a}" in labels]
    if asked:
        return asked, "requested with " + " and ".join(f"review:{a}" for a in asked)
    if author:
        other = AGENTS[1 - AGENTS.index(author)]
        return [other], f"cross-review: {author} wrote this PR"
    return [], None


REVIEW_PROMPT = """You are reviewing GitHub pull request {url}: "{title}".
The full diff is attached on stdin. The current directory may be a checkout of the repository; read files there for context if useful.

Find real defects: wrong behavior, missed edge cases, error handling, security problems, and tests that do not test what they claim. Skip style nits a linter would catch.
For each finding give a priority (P1 breaks something, P2 likely bug, P3 minor), the file and line, what goes wrong with a concrete input, and the fix.
If you find nothing worth reporting, say so in one sentence.

Reply with the review text only, in GitHub Markdown, ready to post. Do not post anything yourself, edit files, or run commands that change state."""


def run_review(reviewer, pr, diff, cwd):
    prompt = REVIEW_PROMPT.format(url=pr["url"], title=pr["title"])
    if reviewer == "claude":
        cmd = ["claude", "-p", prompt, "--output-format", "text", "--no-session-persistence", "--strict-mcp-config",
               "--permission-mode", "dontAsk", "--allowedTools", "Read Grep Glob",
               "--disallowedTools", "Bash Edit Write NotebookEdit WebFetch WebSearch"]
        r = subprocess.run(cmd, input=diff, capture_output=True, text=True, cwd=cwd, timeout=1800)
        out = r.stdout
    else:
        fd, outfile = tempfile.mkstemp(prefix="prbot-codex-", suffix=".md")
        os.close(fd)
        try:
            cmd = ["codex", "exec", "-s", "read-only", "--skip-git-repo-check", "--ephemeral", "-C", cwd,
                   "-o", outfile, prompt]
            r = subprocess.run(cmd, input=diff, capture_output=True, text=True, timeout=1800)
            out = Path(outfile).read_text()
        finally:
            os.unlink(outfile)
    if r.returncode != 0 or not out.strip():
        die(f"{reviewer} review failed (exit {r.returncode}): {(r.stderr or r.stdout)[-500:]}")
    return out.strip()


def review_body(reviewer, reason, pr, text):
    slug = load_config().get(reviewer, {}).get("slug", reviewer)
    return (f"### {reviewer.capitalize()} review\n\n_{reason[0].upper() + reason[1:]}._\n\n{text}\n\n"
            f"<sub>Reviewed commit `{pr['headRefOid'][:10]}` · posted by {slug}[bot]</sub>\n")


def _real_gh():
    gh = os.environ.get("PRBOT_REAL_GH") or shutil.which("gh", path=_path_without_shims())
    if not gh:
        die("gh not found on PATH")
    return gh


def gh_read(args):
    """Reads use the user's own gh login; only posts go through a bot."""
    r = subprocess.run([_real_gh()] + args, capture_output=True, text=True)
    if r.returncode != 0:
        die(f"gh {' '.join(args[:3])} failed: {r.stderr.strip()[:300]}")
    return r.stdout


def cmd_review(target, repo=None, override=None, mode="post", only=None):
    repo = repo or repo_from_args([target]) or repo_from_git()
    if not repo:
        die("cannot tell which repository this PR is in; pass -R owner/repo")
    number = re.sub(r".*/pull/(\d+).*", r"\1", target)
    pr = json.loads(gh_read(["pr", "view", number, "-R", repo, "--json",
                             "number,title,url,headRefOid,labels,commits"]))
    author, why = detect_author(pr)
    reviewers, reason = choose_reviewers(author, [l["name"] for l in pr["labels"]], override)
    if not reviewers:
        print(f"prbot: can't tell who wrote PR #{pr['number']}: {why}.\n"
              f"Ask the user which agent should review it, then rerun with --reviewer claude|codex|both, "
              f"or add a review:claude or review:codex label to the PR.", file=sys.stderr)
        return 3
    if only:  # the watcher asks for just the reviewers still missing on this commit
        reviewers = [r for r in reviewers if r in only]
    print(f"PR #{pr['number']}: author {author or 'unknown'} ({why}); reviewer {' + '.join(reviewers)} ({reason})")
    if mode == "route":
        return 0
    diff = gh_read(["pr", "diff", number, "-R", repo])
    cwd = os.getcwd() if repo_from_git() == repo else tempfile.gettempdir()
    for reviewer in reviewers:
        bot_config(reviewer)  # fail before spending a model run if the bot is not registered
        body = review_body(reviewer, reason, pr, run_review(reviewer, pr, diff, cwd))
        if mode == "dry-run":
            print(body)
            continue
        fd, path = tempfile.mkstemp(prefix="prbot-review-", suffix=".md")
        with os.fdopen(fd, "w") as f:
            f.write(body)
        try:
            env = dict(os.environ, GH_TOKEN=installation_token(reviewer, repo), PRBOT_ACTIVE=reviewer)
            env.pop("GITHUB_TOKEN", None)
            r = subprocess.run([_real_gh(), "pr", "review", number, "-R", repo, "--comment", "--body-file", path],
                               env=env, capture_output=True, text=True)
        finally:
            os.unlink(path)
        if r.returncode != 0:
            die(f"posting the {reviewer} review failed: {r.stderr.strip()[:300]}")
        print(f"posted {reviewer} review: {r.stdout.strip() or pr['url']}")
    return 0

# ---------- watch: review new commits on open PRs as they come in ----------

WATCH_STATE = CONFIG_DIR / "watch-state.json"
WATCH_LIMIT = 3          # model runs per pass, so a backlog can't start a burst of reviews
RETRY_AFTER = 3600       # seconds before retrying a reviewer that failed (usage limit, outage)
REVIEWED = re.compile(r"Reviewed commit `([0-9a-f]{7,40})`")


def installed_repos(bot):
    """owner/name of every repository the bot's App is installed on."""
    cfg = bot_config(bot)
    jwt = app_jwt(cfg.get("client_id") or cfg["app_id"], read_key(bot))
    repos = set()
    for inst in api("GET", "/app/installations", auth=jwt):
        tok = api("POST", f"/app/installations/{inst['id']}/access_tokens", auth=jwt,
                  body={"permissions": {"metadata": "read"}})["token"]
        page = 1
        while True:
            batch = api("GET", f"/installation/repositories?per_page=100&page={page}", auth=tok)["repositories"]
            repos.update(r["full_name"] for r in batch)
            if len(batch) < 100:
                break
            page += 1
    return repos


def reviewed_by(repo, number, sha, slugs):
    """Bots ({'claude', ...}) that already posted a review of this exact commit, read from the review footers."""
    raw = gh_read(["api", f"repos/{repo}/pulls/{number}/reviews", "--paginate",
                   "--jq", '.[] | [.user.login, (.body // "")] | @json'])
    done = set()
    for line in raw.splitlines():
        login, body = json.loads(line)
        m = REVIEWED.search(body)
        if login in slugs and m and sha.startswith(m.group(1)):
            done.add(slugs[login])
    return done


def cmd_watch(dry_run=False, limit=WATCH_LIMIT, baseline=False):
    """One pass over open PRs on every repo the bots are installed on. launchd runs this every 5 minutes.
    --baseline marks the commits open right now as seen without reviewing them, so only new ones get reviews."""
    log = lambda msg: print(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}", flush=True)
    state = json.loads(WATCH_STATE.read_text()) if WATCH_STATE.exists() else {}
    seen, runs = {}, 0
    cfg = load_config()
    bots = [b for b in AGENTS if b in cfg]
    slugs = {cfg[b]["slug"] + "[bot]": b for b in bots}
    installed = {b: installed_repos(b) for b in bots}
    for repo in sorted(set().union(*installed.values())):
        try:
            prs = json.loads(gh_read(["pr", "list", "-R", repo, "--state", "open", "--limit", "100",
                                      "--json", "number,isDraft,headRefOid"]))
        except SystemExit:
            log(f"{repo}: could not list PRs; skipping this pass")
            continue
        for p in prs:
            if p["isDraft"]:
                continue
            n, sha = p["number"], p["headRefOid"]
            key = f"{repo}#{n}@{sha[:10]}"
            entry = seen[key] = state.get(key, {})
            if baseline:
                entry["baseline"] = True
                log(f"{key}: marked as seen; it will not be reviewed unless new commits arrive")
                continue
            if entry.get("skipped") or entry.get("baseline"):
                continue
            try:
                pr = json.loads(gh_read(["pr", "view", str(n), "-R", repo, "--json", "labels,commits"]))
                author, why = detect_author(pr)
                reviewers, _ = choose_reviewers(author, [l["name"] for l in pr["labels"]])
                if not reviewers:
                    entry["skipped"] = why
                    log(f"{key}: skipped, can't tell who wrote it ({why}). Label it agent:claude or "
                        f"agent:codex, or run: prbot review {n} -R {repo} --reviewer claude|codex|both")
                    continue
                todo = [r for r in reviewers if r not in reviewed_by(repo, n, sha, slugs)]
            except SystemExit:
                log(f"{key}: could not read the PR; will retry")
                continue
            for r in todo:
                if r not in installed:
                    log(f"{key}: needs a {r} review, but the {r} bot is not registered")
                    continue
                if repo not in installed[r]:
                    log(f"{key}: needs a {r} review, but the {r} bot is not installed on {repo}")
                    continue
                if time.time() - entry.get(f"failed_{r}", 0) < RETRY_AFTER:
                    continue
                if runs >= limit:
                    log(f"{key}: {r} review waits for the next pass (limit {limit} per pass)")
                    continue
                runs += 1
                if dry_run:
                    log(f"{key}: would run a {r} review")
                    continue
                log(f"{key}: running a {r} review")
                try:
                    cmd_review(str(n), repo, mode="post", only=[r])
                except SystemExit:
                    entry[f"failed_{r}"] = time.time()
                    log(f"{key}: {r} review failed; retrying in {RETRY_AFTER // 60} minutes")
    if not dry_run:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        WATCH_STATE.write_text(json.dumps(seen, indent=1) + "\n")  # keeps only PRs still open
    log(f"pass done: {runs} review{'s' if runs != 1 else ''} {'planned' if dry_run else 'run'}")
    return 0

# ---------- commands ----------


def die(msg, code=2):
    print(f"prbot: {msg}", file=sys.stderr)
    sys.exit(code)


def load_bot_spec(bot, spec_path=None):
    """A bot spec from bots/<bot>.json, or from another repo with --spec. Its logo path is relative to the spec."""
    path = Path(spec_path).expanduser().resolve() if spec_path else ROOT / "bots" / f"{bot}.json"
    if not path.exists():
        die(f"unknown bot '{bot}' (no {path})")
    spec = json.loads(path.read_text())
    spec["logo_path"] = str(path.parent / spec["logo"]) if spec.get("logo") else None
    return spec


def manifest(spec, redirect_url):
    """App manifest. A spec may set its own permissions (workers need contents write); metadata read is required."""
    return {
        "name": spec["name"],
        "url": spec["url"],
        "description": spec["description"],
        "public": False,
        "redirect_url": redirect_url,
        "hook_attributes": {"url": spec["url"], "active": False},
        "default_permissions": {**spec.get("permissions", PERMISSIONS), "metadata": "read"},
        "default_events": [],
    }


def cmd_register(bot, org=None, spec_path=None):
    """GitHub App manifest flow: a local page posts the manifest, GitHub redirects back with a one-hour code."""
    spec = load_bot_spec(bot, spec_path)
    state = secrets.token_urlsafe(16)
    result = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _send(self, body, status=200):
            self.send_response(status)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(body.encode())

        def do_GET(self):
            url = urllib.parse.urlparse(self.path)
            q = urllib.parse.parse_qs(url.query)
            if url.path == "/":
                redirect = f"http://127.0.0.1:{self.server.server_address[1]}/callback"
                target = (f"https://github.com/organizations/{org}/settings/apps/new" if org
                          else "https://github.com/settings/apps/new") + f"?state={state}"
                m = html.escape(json.dumps(manifest(spec, redirect)), quote=True)
                self._send(f'<form id="f" method="post" action="{target}"><input type="hidden" name="manifest" '
                           f'value="{m}"><p>Creating GitHub App <b>{html.escape(spec["name"])}</b>.</p>'
                           f'<button>Continue to GitHub</button></form><script>f.submit()</script>')
            elif url.path == "/callback":
                if q.get("state", [""])[0] != state or "code" not in q:
                    self._send("State mismatch or missing code. Start again with prbot register.", 400)
                    return
                app = api("POST", f"/app-manifests/{q['code'][0]}/conversions")
                where = store_key(bot, app["pem"])
                cfg = load_config()
                cfg[bot] = {"app_id": app["id"], "slug": app["slug"], "client_id": app.get("client_id"),
                            "owner": app["owner"]["login"]}
                save_config(cfg)
                result.update(slug=app["slug"], where=where)
                install = f"https://github.com/apps/{app['slug']}/installations/new"
                self._send(f"<p>Created <b>{html.escape(app['slug'])}</b>. Private key stored in {html.escape(where)}.</p>"
                           f'<p>Next: <a href="{install}">install it on your repos</a>, then upload '
                           f"<code>{html.escape(spec['logo_path'] or 'the logo')}</code> under the App's Display information.</p>")
            else:
                self._send("not found", 404)

    srv = http.server.HTTPServer(("127.0.0.1", 0), Handler)
    print(f"Open this in your browser to create the {spec['name']} App:\n  http://127.0.0.1:{srv.server_address[1]}/")
    while not result:
        srv.handle_request()
    print(f"Registered {result['slug']}. Key stored in {result['where']}.")
    print(f"Install it:      https://github.com/apps/{result['slug']}/installations/new")
    print(f"Upload the logo: https://github.com/settings/apps/{result['slug']}  ({spec['logo_path']})")


def _path_without_shims():
    shim = os.path.realpath(ROOT / "integrations" / "codex" / "bin")
    return os.pathsep.join(p for p in os.environ.get("PATH", "").split(os.pathsep) if os.path.realpath(p) != shim)


def split_gh_args(args):
    """prbot's own options come before '--' ('-R owner/repo'); everything after it goes to gh unchanged."""
    if "--" not in args:
        return None, args
    i = args.index("--")
    return repo_from_args(args[:i]), args[i + 1:]


def bot_identity(bot):
    """(name, email) that make GitHub show a commit as the bot, with its logo. The id is looked up once."""
    cfg = load_config()
    slug = bot_config(bot)["slug"]
    if not cfg[bot].get("user_id"):
        cfg[bot]["user_id"] = json.loads(gh_read(["api", f"users/{slug}%5Bbot%5D"]))["id"]
        save_config(cfg)
    return f"{slug}[bot]", f"{cfg[bot]['user_id']}+{slug}[bot]@users.noreply.github.com"


def git_env(token=None, identity=None):
    """Environment for git as the bot. identity sets author and committer. token, when given, is the only
    credential git uses for github.com; the helper reads it from the environment, so it never reaches disk."""
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    env.pop("GITHUB_TOKEN", None)
    if identity:
        env["GIT_AUTHOR_NAME"] = env["GIT_COMMITTER_NAME"] = identity[0]
        env["GIT_AUTHOR_EMAIL"] = env["GIT_COMMITTER_EMAIL"] = identity[1]
    if token:
        helper = '!f() { echo username=x-access-token; echo "password=$PRBOT_GIT_TOKEN"; }; f'
        pairs = [("credential.helper", ""), ("credential.https://github.com.helper", ""),
                 ("credential.https://github.com.helper", helper)]
        env.update(PRBOT_GIT_TOKEN=token, GIT_CONFIG_COUNT=str(len(pairs)))
        for i, (k, v) in enumerate(pairs):
            env[f"GIT_CONFIG_KEY_{i}"], env[f"GIT_CONFIG_VALUE_{i}"] = k, v
    return env


REMOTE_SUBCOMMANDS = ("push", "fetch", "pull")


def git_subcommand(args):
    """(index, name) of git's subcommand, skipping git's own options such as -C <dir> and -c k=v."""
    i = 0
    while i < len(args) and args[i].startswith("-"):
        i += 2 if args[i] in ("-C", "-c") else 1
    return (i, args[i]) if i < len(args) else (len(args), None)


def cmd_git(bot, args, repo=None):
    """Run git as the bot. Commits get the bot as author and committer; push, fetch and pull get a
    one-hour token with contents write for this repo only."""
    at, sub = git_subcommand(args)
    if sub not in REMOTE_SUBCOMMANDS:
        os.execvpe("git", ["git"] + args, git_env(identity=bot_identity(bot)))
    if not repo:
        remote = next((a for a in args[at + 1:] if not a.startswith("-")), "origin")
        # args[:at] keeps git's own options such as -C <dir>, so the lookup runs where the push would
        r = subprocess.run(["git"] + args[:at] + ["remote", "get-url", remote], capture_output=True, text=True)
        m = re.search(r"github\.com[:/]([^/]+)/([^/\s]+?)(\.git)?\s*$", r.stdout) if r.returncode == 0 else None
        repo = f"{m.group(1)}/{m.group(2)}" if m else None
    if not repo:
        die("cannot tell which GitHub repository this pushes to; pass -R owner/repo")
    env = git_env(installation_token(bot, repo, permissions={"contents": "write"}), bot_identity(bot))
    os.execvpe("git", ["git"] + args, env)


def cmd_gh(bot, args, repo=None):
    repo = repo or repo_from_args(args) or repo_from_git()
    if not repo:
        die("cannot tell which repository this is for; pass -R owner/repo")
    env = dict(os.environ, GH_TOKEN=installation_token(bot, repo), PRBOT_ACTIVE=bot)
    env.pop("GITHUB_TOKEN", None)
    gh = os.environ.get("PRBOT_REAL_GH") or shutil.which("gh", path=_path_without_shims())
    if not gh:
        die("gh not found on PATH")
    os.execve(gh, [gh] + args, env)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == "classify":
        args = rest[1:] if rest[:1] == ["--"] else rest
        args = args[1:] if args[:1] == ["gh"] else args
        return 0 if is_feedback_write(args, load_config().get("codex_triggers_as_bot", False)) else 1
    if cmd == "watch":
        limit = WATCH_LIMIT
        if "--limit" in rest:
            limit = int(rest[rest.index("--limit") + 1])
        return cmd_watch(dry_run="--dry-run" in rest, limit=limit, baseline="--baseline" in rest)
    if cmd == "review":
        opts = {"-R": None, "--repo": None, "--reviewer": None}
        flags, target, i = set(), None, 0
        while i < len(rest):
            a = rest[i]
            if a in opts and i + 1 < len(rest):
                opts[a] = rest[i + 1]
                i += 2
                continue
            if a in ("--dry-run", "--route-only"):
                flags.add(a)
            elif not a.startswith("-") and target is None:
                target = a
            else:
                die(f"review: unexpected argument '{a}'")
            i += 1
        if not target:
            die("usage: prbot review <pr-number|url> [-R owner/repo] [--reviewer claude|codex|both] "
                "[--dry-run|--route-only]")
        if opts["--reviewer"] not in (None, "claude", "codex", "both"):
            die("--reviewer must be claude, codex or both")
        mode = "route" if "--route-only" in flags else "dry-run" if "--dry-run" in flags else "post"
        return cmd_review(target, opts["-R"] or opts["--repo"], opts["--reviewer"], mode)
    if not rest:
        die(f"{cmd}: missing bot name")
    bot = rest[0]
    if cmd == "register":
        cmd_register(bot, rest[rest.index("--org") + 1] if "--org" in rest else None,
                     rest[rest.index("--spec") + 1] if "--spec" in rest else None)
    elif cmd == "import-key":
        cfg = load_config()
        if bot not in cfg:
            if len(rest) < 4:
                die("first import needs: prbot import-key <bot> <pem> <app_id> <owner>")
            cfg[bot] = {"app_id": int(rest[2]), "owner": rest[3]}
            save_config(cfg)
        print("stored in", store_key(bot, Path(rest[1]).read_text()))
    elif cmd == "install-url":
        print(f"https://github.com/apps/{bot_config(bot)['slug']}/installations/new")
    elif cmd == "whoami":
        cfg = bot_config(bot)
        jwt = app_jwt(cfg.get("client_id") or cfg["app_id"], read_key(bot))
        app = api("GET", "/app", auth=jwt)
        print(f"{app['slug']}[bot]  app_id={app['id']}  owner={app['owner']['login']}")
        for i in api("GET", "/app/installations", auth=jwt):
            print(f"  installed on {i['account']['login']} ({i['repository_selection']} repos)")
    elif cmd == "gh":
        repo, args = split_gh_args(rest[1:])
        cmd_gh(bot, args, repo)
    elif cmd == "git":
        repo, args = split_gh_args(rest[1:])
        cmd_git(bot, args, repo)
    else:
        die(f"unknown command '{cmd}'")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
