# ---------- classification: which gh calls write PR feedback ----------

WRITE_SUBCOMMANDS = {("pr", "review"), ("pr", "comment"), ("issue", "comment")}
CLOSE_SUBCOMMANDS = {("pr", "close"), ("issue", "close")}  # feedback only when they carry -c/--comment
CODEX_TRIGGER = re.compile(r"@codex(\s.*)?", re.S)  # `@codex` first, alone or followed by whitespace
FEEDBACK_PATH = re.compile(r"/(comments|reviews|replies)(/|$|\?|#)|/reviews/\d+/(events|dismissals)")
FEEDBACK_MUTATION = re.compile(r"\b(addPullRequestReview\w*|submitPullRequestReview|addComment|updateIssueComment|"
                               r"updatePullRequestReview\w*|resolveReviewThread|unresolveReviewThread|"
                               r"deleteIssueComment|deletePullRequestReview\w*|dismissPullRequestReview|"
                               r"minimizeComment|unminimizeComment)\b")
FIELD_FLAGS = ("-f", "-F", "--field", "--raw-field", "--input")
WRITE_METHODS = ("POST", "PATCH", "PUT", "DELETE")
GH_GLOBAL_VALUE = ("-R", "--repo", "--hostname")
# options of the comment and close subcommands that take a value, so their operand is never read as a body
COMMENT_VALUE_SHORT, COMMENT_VALUE_LONG = "FR", ("--body-file", "--repo", "--hostname")
CLOSE_VALUE_SHORT, CLOSE_VALUE_LONG = "rR", ("--reason", "--repo", "--duplicate-of", "--hostname")
# gh api options that take a value, so their operand is never taken for the endpoint
API_VALUE_SHORT = "XfFHqtp"
API_VALUE_LONG = ("--method", "--field", "--raw-field", "--input", "--header", "--jq", "--template",
                  "--preview", "--hostname", "--cache")
PAYLOAD_LIMIT = 4 << 20  # larger payload files count as writes instead of being read
STDIN_PATHS = ("-", "/dev/stdin", "/dev/fd/0", "/proc/self/fd/0")  # never opened, so stdin is never consumed


def _skip_gh_globals(args, i):
    """Index of the first word at or after i that is not -R/--repo/--hostname or their operand."""
    while i < len(args):
        a = args[i]
        if a in GH_GLOBAL_VALUE:
            i += 2
        elif a.startswith(("--repo=", "--hostname=")) or (a.startswith("-R") and len(a) > 2):
            i += 1
        else:
            break
    return i


def gh_command(args):
    """(group, subcommand, rest) of a gh argv. -R/--repo/--hostname may come before the group or between the group
    and the subcommand, as gh accepts both. For `api` the subcommand is None and rest is everything after it."""
    i = _skip_gh_globals(args, 0)
    if i >= len(args):
        return None, None, []
    group = args[i]
    if group == "api":
        return group, None, args[i + 1:]
    j = _skip_gh_globals(args, i + 1)
    if j >= len(args):
        return group, None, args[i + 1:]
    return group, args[j], args[i + 1:j] + args[j + 1:]


def _option_values(args, short, long, value_short, value_long):
    """Values given to one option of a gh subcommand, read the way gh's flag parser reads them: -cX, -c X,
    --comment X, --comment=X and short clusters such as -dc X. value_short and value_long name the subcommand's
    other options that take a value, so their operands are never mistaken for this option. A missing operand
    is returned as None."""
    out, i = [], 0
    while i < len(args):
        a = args[i]
        if a == "--":
            break
        if a.startswith("--"):
            name, eq, val = a.partition("=")
            takes_next = not eq and (name == long or name in value_long)
            if name == long:
                out.append(val if eq else (args[i + 1] if i + 1 < len(args) else None))
            i += 2 if takes_next else 1
            continue
        if a.startswith("-") and len(a) > 1:
            step = 1
            for k in range(1, len(a)):
                ch = a[k]
                if ch == short or ch in value_short:
                    val = a[k + 1:]
                    if not val:
                        val = args[i + 1] if i + 1 < len(args) else None
                        step = 2
                    if ch == short:
                        out.append(val)
                    break
            i += step
            continue
        i += 1
    return out


def _only_options(args, allowed_short, allowed_long, value_short, value_long):
    """True when every option in args (up to `--`) is one of allowed_short or allowed_long. value_short and
    value_long name the options that take a value, so their operands are never read as options."""
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--":
            return True
        if a.startswith("--"):
            name, eq, _ = a.partition("=")
            if name not in allowed_long:
                return False
            i += 2 if not eq and name in value_long else 1
            continue
        if a.startswith("-") and len(a) > 1:
            step = 1
            for k in range(1, len(a)):
                ch = a[k]
                if ch not in allowed_short:
                    return False
                if ch in value_short:
                    step = 1 if a[k + 1:] else 2
                    break
            i += step
            continue
        i += 1
    return True


class Undecided(Exception):
    """classify will not let this gh call run as a read; the Codex shim refuses it."""


# The Codex shim runs the real gh only for calls on this safe list. gh expands user aliases from its config.yml and
# runs extensions under any top-level name it does not own, and it accepts aliases nested under a command group
# (`pr human-review`), but never under a runnable command and never shadowing a built-in name. So a call is let
# through only when its first word after the global options is a built-in gh command below and, for a command
# group, its subcommand is listed under it. The config is never read: every alias, the default `co` included,
# and every extension is refused, whatever config.yml says. A gh call that is not listed is refused, not guessed.
# Runnable top-level commands without subcommands; nothing can be nested under them.
GH_LEAF_COMMANDS = {"api", "browse", "status", "version", "completion", "licenses"}
# gh's help topics: they only print text
GH_HELP_TOPICS = {"accessibility", "actions", "environment", "exit-codes", "formatting", "mintty", "reference",
                  "telemetry"}
# command groups (gh's own spelling, built-in aliases resolve to it) and the subcommands the shim may run; gh's
# built-in subcommand aliases such as `pr ls` and `pr co` are listed by name. Commands that change gh's aliases,
# extensions, config or login, print a token, or run another program (alias set, extension exec, config set,
# auth token, copilot, codespace) are left off.
GH_SAFE_SUBCOMMANDS = {
    "pr": {"view", "diff", "list", "ls", "checks", "status", "create", "new", "merge", "edit", "checkout", "co",
           "ready", "close", "reopen", "comment", "review", "lock", "unlock", "update-branch", "revert"},
    "issue": {"view", "list", "ls", "status", "create", "new", "close", "reopen", "comment", "edit", "lock",
              "unlock", "pin", "unpin", "develop"},
    "repo": {"view", "list", "ls", "clone", "fork", "sync", "set-default", "read-file", "read-dir", "create", "new"},
    "run": {"view", "list", "ls", "watch", "download", "rerun", "cancel"},
    "workflow": {"view", "list", "ls", "run", "enable", "disable"},
    "release": {"view", "list", "ls", "download", "verify", "verify-asset"},
    "label": {"list", "ls", "create", "edit", "clone"},
    "search": {"code", "commits", "issues", "prs", "repos"},
    "auth": {"status"},
    "cache": {"list", "ls"},
    "gist": {"view", "list", "ls"},
    "org": {"list", "ls"},
    "ruleset": {"view", "list", "ls", "check"},
    "secret": {"list", "ls"},
    "variable": {"get", "list", "ls"},
    "alias": {"list", "ls"},
    "extension": {"list", "ls", "search"},
    "config": {"get", "list", "ls"},
    "attestation": {"verify", "download", "trusted-root"},
    "discussion": {"view", "list"},
    "project": {"view", "list", "ls", "field-list", "item-list"},
}
# built-in names gh resolves to the groups above; `co` is not one of them, it is a config alias that can be redefined
GH_GROUP_ALIASES = {"ext": "extension", "extensions": "extension", "rs": "ruleset", "at": "attestation"}
# groups gh owns but the shim never runs; named so the refusal says what they are
GH_UNSAFE_GROUPS = {"codespace", "cs", "copilot", "preview", "skill", "skills", "agent-task", "agent-tasks", "agent",
                    "agents", "gpg-key", "ssh-key", "send-telemetry", "credits"}
GH_HELP_FLAGS = ("--help", "-h")


def classify_gh(args, codex_triggers_as_bot=False):
    """args: the gh argv without the leading 'gh', exactly as gh receives it. True for a PR feedback write, False
    for a call the shim may pass to the real gh, and Undecided for anything off the safe list above."""
    i = _skip_gh_globals(args, 0)
    if i >= len(args):
        return False  # bare gh (or only -R) prints help
    first, tail = args[i], args[i + 1:]
    if first.startswith("-"):
        # gh hands the rest of the line to a shell alias unparsed, so `--help human-review` would run the alias
        if first in ("--version",) + GH_HELP_FLAGS and not tail:
            return False
        raise Undecided(f"gh option {first} before the command; put the command first")
    if first in GH_LEAF_COMMANDS:
        return is_feedback_write(args, codex_triggers_as_bot)
    if first in GH_HELP_TOPICS and not tail:
        return False
    if first == "help":
        if not tail or (len(tail) <= 2 and all(_gh_known_name(t) for t in tail)):
            return False
        raise Undecided("gh help with a name gh does not own (an alias or an extension)")
    group = GH_GROUP_ALIASES.get(first, first)
    if group not in GH_SAFE_SUBCOMMANDS:
        if first in GH_UNSAFE_GROUPS:
            raise Undecided(f"gh {first} is not run from an agent session; run it from your own terminal")
        raise Undecided(f"gh {first} is not a built-in gh command; aliases and extensions are not run from an "
                        "agent session (gh would run them as you)")
    j = _skip_gh_globals(args, i + 1)
    if j >= len(args):
        return False  # a bare group prints its help
    sub = args[j]
    if sub.startswith("-"):
        if sub in GH_HELP_FLAGS and j + 1 == len(args):
            return False
        raise Undecided(f"gh {first} {sub}: put the subcommand right after {first}")
    if sub not in GH_SAFE_SUBCOMMANDS[group]:
        raise Undecided(f"gh {first} {sub} is not on the shim's safe list (it may be an alias or an extension, or "
                        "change gh's own setup); run it from your own terminal")
    rest = args[j + 1:]
    if (group, sub) == ("auth", "status") and _shows_token(rest):
        raise Undecided("gh auth status --show-token prints the token")
    return is_feedback_write(args, codex_triggers_as_bot)


def _shows_token(rest):
    """True when gh auth status options include -t/--show-token, alone or in a short cluster such as -at."""
    for a in rest:
        if a == "--":
            return False
        if a.startswith("--"):
            if a.partition("=")[0] == "--show-token":
                return True
        elif a.startswith("-"):
            for ch in a[1:]:
                if ch == "t":
                    return True
                if ch in "hqT":  # takes a value: the rest of the word is that value
                    break
    return False


def _gh_known_name(word):
    """True for a name gh owns at the top level or a subcommand listed above, used to let `gh help pr view` print."""
    return (word in GH_LEAF_COMMANDS or word in GH_HELP_TOPICS or word in GH_SAFE_SUBCOMMANDS
            or word in GH_GROUP_ALIASES or any(word in subs for subs in GH_SAFE_SUBCOMMANDS.values()))


def is_codex_trigger(text):
    """True for a body that is a Codex Cloud trigger: `@codex` at the very start, followed by the end of the text
    or whitespace."""
    return text is not None and CODEX_TRIGGER.fullmatch(text) is not None


def is_feedback_write(args, codex_triggers_as_bot=False):
    """args: the gh argv without the leading 'gh'. Only a plain comment or close comment whose text is a Codex
    trigger stays on the human account; a `pr review` is always a feedback write, whatever its body or verdict."""
    group, sub, rest = gh_command(args)
    if group == "api":
        return _api_feedback_write(rest)
    if (group, sub) == ("pr", "review"):
        return True  # an approval or change request from the human account is what the guard most needs to stop
    if (group, sub) in WRITE_SUBCOMMANDS:
        values = _option_values(rest, "b", "--body", COMMENT_VALUE_SHORT, COMMENT_VALUE_LONG)
        plain = _only_options(rest, "bR", ("--body", "--repo", "--hostname"), "bFR", COMMENT_VALUE_LONG + ("--body",))
    elif (group, sub) in CLOSE_SUBCOMMANDS:
        values = _option_values(rest, "c", "--comment", CLOSE_VALUE_SHORT, CLOSE_VALUE_LONG)
        if not values:
            return False  # closing without a comment posts no feedback
        plain = True
    else:
        return False
    text = values[-1] if values else None  # gh keeps the last value when an option repeats
    if plain and is_codex_trigger(text) and not codex_triggers_as_bot:
        return False  # Codex Cloud triggers stay on the human account until tested
    return True


def _api_feedback_write(rest):
    """rest: the gh api argv after 'api'."""
    method, fields, inputs, endpoint = None, [], [], None
    i, only_positional = 0, False
    while i < len(rest):
        a = rest[i]
        if only_positional or a == "-" or not a.startswith("-"):
            endpoint = a if endpoint is None else endpoint
            i += 1
            continue
        if a == "--":
            only_positional = True
            i += 1
            continue
        if a.startswith("--"):
            name, eq, val = a.partition("=")
            if name in API_VALUE_LONG and not eq:
                val = rest[i + 1] if i + 1 < len(rest) else ""
                i += 2
            else:
                i += 1
            if name == "--method":
                method = val.upper()
            elif name in ("--field", "--raw-field"):
                fields.append(val)
            elif name == "--input":
                inputs.append(val)
            continue
        step = 1
        for k in range(1, len(a)):  # short cluster: a value option takes the rest of the token or the next one
            ch = a[k]
            if ch in API_VALUE_SHORT:
                val = a[k + 1:]
                if not val:
                    val = rest[i + 1] if i + 1 < len(rest) else ""
                    step = 2
                if ch == "X":
                    method = val.upper()
                elif ch in "fF":
                    fields.append(val)
                break
        i += step
    if not (method in WRITE_METHODS or (method is None and (fields or inputs))):
        return False  # gh api sends GET without fields or with an explicit GET
    if endpoint is None:
        return False
    if re.split(r"[?#]", endpoint)[0].rstrip("/").endswith("graphql"):  # a query string doesn't change the route
        return _graphql_feedback_write(rest, fields, inputs)
    return FEEDBACK_PATH.search(endpoint) is not None


def _graphql_feedback_write(rest, fields, inputs):
    """True when a GraphQL call carries a feedback mutation inline or in a payload file, or when a payload file
    can't be read safely, since its contents are then unknown."""
    if any(FEEDBACK_MUTATION.search(a) for a in rest):
        return True
    files = [f.partition("=")[2][1:] for f in fields if f.partition("=")[2].startswith("@")] + inputs
    for path in files:
        text = _read_payload(path)
        if text is None or _payload_has_mutation(text):
            return True
    return False


def _read_payload(path):
    """Text of a local regular payload file, relative paths taken from the current directory. None for stdin,
    a missing file, anything that is not a regular file, a read error, a file over PAYLOAD_LIMIT or text that is
    not UTF-8. The file is opened non-blocking and checked before reading, so a FIFO or device never blocks."""
    if not path or path in STDIN_PATHS:
        return None
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOCTTY", 0))
    except (OSError, ValueError):
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        with os.fdopen(fd, "rb", closefd=False) as f:
            data = f.read(PAYLOAD_LIMIT + 1)
    except OSError:
        return None
    finally:
        os.close(fd)
    if len(data) > PAYLOAD_LIMIT:
        return None
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        return None


def _payload_has_mutation(text):
    """Look for a feedback mutation in raw text and, for a JSON body, in every decoded string."""
    if FEEDBACK_MUTATION.search(text):
        return True
    try:
        data = json.loads(text)
    except ValueError:
        return False
    except RecursionError:
        return True  # too deep to inspect: treat as a write
    stack = [data]
    while stack:
        x = stack.pop()
        if isinstance(x, str):
            if FEEDBACK_MUTATION.search(x):
                return True
        elif isinstance(x, dict):
            stack.extend(x.keys())
            stack.extend(x.values())
        elif isinstance(x, list):
            stack.extend(x)
    return False


# Covered shell forms. This is not a shell parser: it splits on ; & | ( ), skips the words below, and looks inside
# backticks and `bash|sh|zsh -c` strings, at most MAX_NESTING levels deep.
SHELL_KEYWORDS = ("then", "do", "else", "elif", "{", "!", "if", "while", "until")
SHELLS = ("bash", "sh", "zsh")
MAX_NESTING = 4
ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
# wrapper: (short options with an operand, short options with an optional attached operand,
#           long options with an operand, long options with an optional attached operand).
# Option sets cover GNU and BSD/macOS. Every other option is taken as a flag; a word not starting with - (or anything after --) is the command.
WRAPPERS = {
    "env": ("uCSP", "", ("--unset", "--chdir", "--split-string"), ()),
    "time": ("fo", "", ("--format", "--output"), ()),
    "command": ("", "", (), ()),
    "exec": ("a", "", (), ()),
    "nohup": ("", "", (), ()),
    "sudo": ("CDghprRtTUu", "", ("--close-from", "--chdir", "--group", "--host", "--prompt", "--chroot", "--role",
                                 "--type", "--command-timeout", "--other-user", "--user"), ("--preserve-env",)),
    "xargs": ("IanLPsEdJRS", "ile", ("--arg-file", "--max-args", "--max-procs", "--max-chars", "--delimiter",
                                  "--process-slot-var"), ("--replace", "--max-lines", "--eof")),
}


PUNCTUATION = ";&|()<>\n"
# one shell operator inside a run of punctuation; process substitution <( and >( first, so it separates
OPERATOR = re.compile(r"[<>]\(|&>>?|<<<|<<|<>|>>|>&|>\||<&|&&|\|\||;;|[<>;&|()\n]")


def _drop_fd_numbers(command):
    """The command without file descriptor numbers in front of redirections (2>x, 2>&1), outside quotes, so
    they are never read as words."""
    out, quote, i = [], None, 0
    while i < len(command):
        ch = command[i]
        if quote:
            if ch == quote:
                quote = None
            elif ch == "\\" and quote == '"':
                out.append(command[i:i + 2])
                i += 2
                continue
        elif ch == "\\":
            out.append(command[i:i + 2])
            i += 2
            continue
        elif ch in "'\"":
            quote = ch
        elif ch.isdigit() and (i == 0 or command[i - 1] in " \t\r" + PUNCTUATION):
            j = i
            while j < len(command) and command[j].isdigit():
                j += 1
            if j < len(command) and command[j] in "<>":
                i = j
                continue
        out.append(ch)
        i += 1
    return "".join(out)


def _tokens(command):
    """Shell words, with ; & | ( ) and unquoted newlines as separate tokens and each redirection operator as one
    token. A backslash-newline joins lines."""
    command = _drop_fd_numbers(command.replace("\\\n", ""))
    lex = shlex.shlex(command, posix=True, punctuation_chars=PUNCTUATION)
    lex.whitespace = " \t\r"  # a newline ends a command, like ;
    lex.whitespace_split = True
    lex.commenters = ""
    try:
        words = list(lex)
    except ValueError:  # unbalanced quotes: fall back to a rough split rather than letting the call through
        words = re.findall(r"[;&|()<>\n]+|[^\s;&|()<>]+", command)
    out = []
    for w in words:  # shlex joins neighbouring punctuation (;>, &&>), so split each run into operators
        out.extend(OPERATOR.findall(w) if w and set(w) <= set(PUNCTUATION) else [w])
    return out


def _is_operator(tok):
    return bool(tok) and set(tok) <= set(PUNCTUATION)


def _is_redirection(tok):
    return _is_operator(tok) and bool(set(tok) & set("<>")) and "(" not in tok


def _closing_paren(command, i):
    """Index of the ) that closes a $( whose body starts at i, skipping quoted text, or len(command)."""
    depth, quote = 1, None
    while i < len(command):
        ch = command[i]
        if quote:
            if ch == quote:
                quote = None
            elif ch == "\\" and quote == '"':
                i += 1
        elif ch == "\\":
            i += 1
        elif ch in "'\"":
            quote = ch
        elif ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
            if depth == 0:
                return i
        i += 1
    return i


def _unescape_backticks(body):
    """A backtick body as the shell runs it: inside `...`, a backslash quotes only $, ` and itself."""
    return re.sub(r"\\([$`\\])", r"\1", body)


def _substitutions(command):
    """Command strings inside `...` and inside $(...) within double quotes, outside single quotes and not escaped.
    Unquoted $(...) needs no special case, since ( and ) already split commands. An unclosed substitution yields
    the rest of the string."""
    out, quote, start, i = [], None, None, 0
    while i < len(command):
        ch = command[i]
        if quote == "'":
            if ch == "'":
                quote = None
        elif ch == "\\":
            i += 2
            continue
        elif ch == "`":
            if start is None:
                start = i + 1
            else:
                out.append(_unescape_backticks(command[start:i]))
                start = None
        elif start is None and quote == '"' and command.startswith("$(", i):
            end = _closing_paren(command, i + 2)
            out.append(command[i + 2:end])
            i = end + 1
            continue
        elif start is None and ch == "'" and quote is None:
            quote = "'"
        elif start is None and ch == '"':
            quote = None if quote == '"' else '"'
        i += 1
    if start is not None:
        out.append(_unescape_backticks(command[start:]))
    return out


def _skip_options(seg, i, spec, split=()):
    """(index of the wrapped command, [(option, value)], None) for a wrapper's options starting at seg[i].
    An option named in split (env -S) stops the scan at once: the third item is then (value, start, prefix, end),
    where seg[start:end] holds the option and its value and prefix is any flags clustered before it."""
    value_short, optional_short, value_long, optional_long = spec
    found = []
    while i < len(seg):
        t = seg[i]
        if t == "--":
            return i + 1, found, None
        if t.startswith("--"):
            name, eq, val = t.partition("=")
            if name in value_long and not eq:
                val, end = (seg[i + 1] if i + 1 < len(seg) else ""), i + 2
            else:
                val, end = (val if eq else None), i + 1
            found.append((name, val))
            if name in split:
                return end, found, (val or "", i, "", end)
            i = end
            continue
        if not t.startswith("-") or t == "-":
            return i, found, None
        step = 1
        for k in range(1, len(t)):
            ch = t[k]
            if ch in value_short:
                val = t[k + 1:]
                if not val:
                    val = seg[i + 1] if i + 1 < len(seg) else ""
                    step = 2
                found.append((ch, val))
                if ch in split:
                    return i + step, found, (val, i, t[:k] if k > 1 else "", i + step)
                break
            if ch in optional_short:
                found.append((ch, t[k + 1:] or None))
                break
            found.append((ch, None))
        i += step
    return i, found, None


def _shell_script(args):
    """The command string of `bash|sh|zsh [options] -c STRING`, or None."""
    i, has_c = 0, False
    while i < len(args):
        a = args[i]
        if a == "--":
            i += 1
            break
        if a in ("--rcfile", "--init-file"):
            i += 2
            continue
        if a.startswith("--"):
            i += 1
            continue
        if len(a) > 1 and a[0] in "-+":
            has_c = has_c or (a[0] == "-" and "c" in a[1:])
            i += 2 if ("o" in a[1:] or "O" in a[1:]) else 1  # -o/-O take an option name
            continue
        break
    return args[i] if has_c and i < len(args) else None


def _simple_command(seg, depth):
    i, leading = 0, True
    while i < len(seg):
        t = seg[i]
        if leading and t in SHELL_KEYWORDS:
            i += 1
            continue
        if ASSIGNMENT.match(t):
            i, leading = i + 1, False
            continue
        name = os.path.basename(t)
        if name not in WRAPPERS:
            break
        leading = False
        at = i
        i, opts, split = _skip_options(seg, at + 1, WRAPPERS[name], ("S", "--split-string") if name == "env" else ())
        if name == "command" and any(o in ("v", "V") for o, _ in opts):
            return  # command -v/-V only looks the program up
        if split:  # env -S: its string becomes more env arguments in its place, then env is read again
            value, start, prefix, end = split
            seg = seg[:start] + ([prefix] if prefix else []) + _tokens(value) + seg[end:]
            i = at
    if i >= len(seg):
        return
    prog, args = os.path.basename(seg[i]), seg[i + 1:]
    yield prog, args
    if prog in SHELLS and depth < MAX_NESTING:
        script = _shell_script(args)
        if script is not None:
            yield from _commands(script, depth + 1)


def _commands(command, depth=0):
    """Yield (program, argv) for each simple command in a shell command string, skipping shell keywords,
    VAR=... and wrappers, and looking inside backticks and bash|sh|zsh -c strings up to MAX_NESTING deep."""
    if depth < MAX_NESTING:
        for inner in _substitutions(command):
            yield from _commands(inner, depth + 1)
    seg, toks, k = [], _tokens(command) + [";"], 0
    while k < len(toks):
        tok = toks[k]
        if _is_redirection(tok):  # the shell removes a redirection and its target before running the command
            k += 1 if _is_operator(toks[k + 1]) else 2
            continue
        if _is_operator(tok):
            yield from _simple_command(seg, depth)
            seg = []
        else:
            seg.append(tok)
        k += 1


def gh_calls(command):
    """Yield (argv_after_gh, routed_through_prbot) for each gh or prbot call in a shell command string."""
    for prog, args in _commands(command):
        if prog in ("gh", "prbot"):
            yield args, prog == "prbot"


GUARDED_GIT = ("commit", "push")


def git_writes(command):
    """(argv_after_git, -C dir or None) for each plain `git commit` or `git push` in a shell command string."""
    for prog, args in _commands(command):
        if prog != "git":
            continue
        at, sub = git_subcommand(args)
        if sub in GUARDED_GIT:
            yield args, _git_dir(args[:at])


def _git_dir(opts):
    """The directory git runs in from its own options: -C <dir>, then --git-dir <dir> under it; None for cwd."""
    cdir = gitdir = None
    i = 0
    while i < len(opts):
        o = opts[i]
        if o in ("-C", "--git-dir") and i + 1 < len(opts):
            if o == "-C":
                cdir = os.path.join(cdir, opts[i + 1]) if cdir else opts[i + 1]
            else:
                gitdir = opts[i + 1]
        elif o.startswith("--git-dir="):
            gitdir = o.partition("=")[2]
        i += 2 if o in GIT_VALUE_OPTIONS else 1
    if gitdir:
        return os.path.join(cdir, gitdir) if cdir else gitdir
    return cdir


def unrouted_writes(command, codex_triggers_as_bot=False):
    """gh argv lists in a shell command that write PR feedback without going through prbot."""
    return [args for args, routed in gh_calls(command)
            if not routed and is_feedback_write(args, codex_triggers_as_bot)]

# ---------- the Bash guard: a safe-list over one strict shell lexer ----------
#
# The Claude Code hook asks guard_bash() about every Bash command. A command whose text names gh, git or prbot
# runs only when every simple command in it is on the safe list below. Anything the lexer can't read, any
# if/for/while block, subshell or { } group, wrapper (env, sudo, xargs, nohup, ...), output redirection to a
# file, or program it doesn't know is refused. Any command at all is refused when shell indirection could build
# a program name the text never shows: a program name made at run time ($x, ${x}h, $'\x67h', a glob), eval or
# sh -c with non-literal content, a shell reading commands from stdin, xargs -I and env -S.

class Unparseable(Exception):
    pass


# case-insensitive: the default macOS volume finds the gh binary for GH or Gh too
GUARD_MENTION = re.compile(r"(?<![A-Za-z0-9_])(gh|git|prbot)(?![A-Za-z0-9_])", re.I)
# when the lexer gives up, a command is still allowed only if none of these appear in it
GUARD_SUSPICIOUS = re.compile(r"[$`*?\[{]|\(\(|(?<![A-Za-z0-9_.-])(eval|exec|source|xargs|env|sudo|command|builtin|"
                              r"sh|bash|zsh|dash|ksh|fish)(?![A-Za-z0-9_.-])|(?:^|[\s;&|(])\.\s")
GUARD_RESERVED = {"if", "then", "else", "elif", "fi", "do", "done", "while", "until", "for", "in", "{", "}", "!",
                  "[[", "]]", "time"}
GUARD_UNSUPPORTED = {"case", "esac", "select", "function", "coproc"}
GUARD_REDIRECT = re.compile(r"([0-9]+)?(&>>|&>|>>|>\||>&|<<<|<<-|<<|<>|<&|>|<)")
GUARD_MAX_DEPTH = 8
DYN = "\0"  # stands for a part of a word that is only known at run time


class Word:
    __slots__ = ("text", "dynamic", "split", "quoted", "glob", "ansi", "body", "raw")

    def __init__(self):
        self.text, self.dynamic, self.split, self.quoted, self.glob = "", False, False, False, False
        self.ansi, self.body, self.raw = False, None, ""  # ansi: has a $'...' part; body: here-document text

    def __repr__(self):
        return f"Word({self.text!r}{', dynamic' if self.dynamic else ''})"


class SimpleCommand:
    __slots__ = ("words", "assigns", "redirects", "piped", "complex", "op_before", "op_after", "nested",
                 "dbl_bracket")

    def __init__(self, piped=False, complex_=False, op_before=None, nested=False):
        self.words, self.assigns, self.redirects = [], [], []
        self.piped, self.complex, self.op_before, self.op_after = piped, complex_, op_before, None
        self.nested = nested  # inside $( ), backticks, <( ) or >( ): runs in a subshell
        self.dbl_bracket = False  # starts with [[

    def empty(self):
        return not (self.words or self.assigns or self.redirects)


class _Lexer:
    """Reads a bash command string into simple commands, the ones inside $( ), ` `, <( ) and >( ) included,
    or raises Unparseable for anything it does not fully understand."""

    def __init__(self, src, depth=0):
        if depth > GUARD_MAX_DEPTH:
            raise Unparseable("nested too deeply")
        self.src, self.i, self.depth, self.out, self.heredocs = src, 0, depth, [], []

    def peek(self, k=0):
        j = self.i + k
        return self.src[j] if j < len(self.src) else ""

    def parse(self):
        self.parse_list(None, False)
        if self.heredocs:
            self.read_heredocs()
        return self.out

    def finish(self, cmd):
        if not cmd.empty():
            cmd.nested = cmd.nested or self.depth > 0
            self.out.append(cmd)

    def parse_list(self, stop, complex_):
        cmd = SimpleCommand(complex_=complex_)
        skip_words = False  # after `for`: the loop variable and its word list are not commands
        while True:
            self.skip_blanks()
            c = self.peek()
            if not c:
                if stop:
                    raise Unparseable("unclosed parenthesis")
                self.finish(cmd)
                return
            if c == "#":
                while self.peek() and self.peek() != "\n":
                    self.i += 1
                continue
            if c == "\n":
                self.i += 1
                cmd.op_after = "\n"
                self.finish(cmd)
                self.read_heredocs()
                cmd, skip_words = SimpleCommand(complex_=complex_, op_before="\n"), False
                continue
            if c == ")":
                if stop != ")":
                    raise Unparseable("unmatched )")
                self.i += 1
                self.finish(cmd)
                return
            m = GUARD_REDIRECT.match(self.src, self.i)
            if m and not (c in "<>" and self.peek(1) == "("):
                self.i = m.end()
                self.redirect(cmd, m.group(2))
                continue
            if c in ";&|":
                op = c
                if self.peek(1) in ("&", "|", ";") and self.src[self.i:self.i + 2] in ("&&", "||", ";;", "|&"):
                    op = self.src[self.i:self.i + 2]
                if op == ";;":
                    raise Unparseable("case statements are not supported")
                self.i += len(op)
                cmd.op_after = op
                self.finish(cmd)
                cmd, skip_words = SimpleCommand(piped=op in ("|", "|&"), complex_=complex_, op_before=op), False
                continue
            if c == "(":
                if cmd.words or cmd.assigns:
                    raise Unparseable("unexpected (")
                self.i += 1
                if self.peek() == "(":
                    raise Unparseable("arithmetic commands are not supported")
                self.parse_list(")", True)
                cmd.complex = True
                continue
            start = self.i
            word = self.read_word()
            if skip_words:
                if not word.quoted and not word.dynamic and word.text == "do":
                    skip_words = False  # for x do CMD; done: the body starts here
                continue
            if not cmd.words and not word.quoted and not word.dynamic:
                if word.text in GUARD_UNSUPPORTED:
                    raise Unparseable(f"`{word.text}` is not supported")
                if word.text in GUARD_RESERVED:
                    if word.text == "[[":
                        cmd.dbl_bracket = True
                    cmd.complex = complex_ = True
                    skip_words = word.text == "for"
                    continue
            # NAME=value before the program is an assignment when NAME= itself is unquoted, whatever the value
            if not cmd.words and re.match(r"[A-Za-z_][A-Za-z0-9_]*\+?=", self.src[start:self.i]):
                cmd.assigns.append(word)
                continue
            cmd.words.append(word)

    def skip_blanks(self):
        while True:
            c = self.peek()
            if c in (" ", "\t"):
                self.i += 1
            elif c == "\\" and self.peek(1) == "\n":
                self.i += 2
            else:
                return

    def redirect(self, cmd, op):
        self.skip_blanks()
        if not self.peek() or self.peek() in "\n;&|()<>":
            raise Unparseable(f"redirection {op} without a target")
        target = self.read_word()
        if op in ("<<", "<<-"):
            self.heredocs.append((target, op == "<<-"))
        cmd.redirects.append((op, target))

    def read_heredocs(self):
        """Consume the bodies of the here-documents opened on the line that just ended."""
        pending, self.heredocs = self.heredocs, []
        for target, strip_tabs in pending:
            delim = target.text
            if target.dynamic:
                raise Unparseable("here-document delimiter is not literal")
            body = []
            while self.i < len(self.src):
                end = self.src.find("\n", self.i)
                end = len(self.src) if end < 0 else end
                line = self.src[self.i:end]
                self.i = min(end + 1, len(self.src))
                if (line.lstrip("\t") if strip_tabs else line) == delim:
                    break
                body.append(line)
            text = "\n".join(body)
            target.body = text
            # an unquoted delimiter means the body is expanded, so $( ) and backticks in it run commands
            if not target.quoted and ("`" in text or "$(" in text or "${" in text):
                raise Unparseable("here-document with command substitution")

    def read_word(self):
        w, unquoted, start = Word(), [], self.i
        try:
            return self._read_word(w, unquoted)
        finally:
            w.raw = self.src[start:self.i]

    def _read_word(self, w, unquoted):
        while True:
            c = self.peek()
            if not c or c in " \t\n;&|)":
                break
            if c in "<>":
                if self.peek(1) == "(":
                    self.i += 2
                    self.nested(w)
                    continue
                break
            if c == "(":
                raise Unparseable("unexpected ( inside a word")
            if c == "\\":
                if self.peek(1) == "\n":
                    self.i += 2
                    continue
                if not self.peek(1):
                    raise Unparseable("trailing backslash")
                w.text += self.peek(1)
                w.quoted = True
                self.i += 2
                continue
            if c == "'":
                end = self.src.find("'", self.i + 1)
                if end < 0:
                    raise Unparseable("unclosed single quote")
                w.text += self.src[self.i + 1:end]
                w.quoted = True
                self.i = end + 1
                continue
            if c == '"':
                self.i += 1
                self.double_quoted(w)
                w.quoted = True
                continue
            if c == "$":
                self.dollar(w, in_dq=False)
                continue
            if c == "`":
                self.backtick(w, in_dq=False)
                continue
            unquoted.append(c)
            w.text += c
            self.i += 1
        bare = "".join(unquoted)
        # a pattern the shell may expand into other words: * and ?, a [..] class, or a {a,b} / {1..3} brace
        w.glob = bool(re.search(r"[*?]|\[[^\]]*\]|\{[^}]*(,|\.\.)[^}]*\}", bare))
        return w

    def double_quoted(self, w):
        while True:
            c = self.peek()
            if not c:
                raise Unparseable("unclosed double quote")
            if c == '"':
                self.i += 1
                return
            if c == "\\":
                n = self.peek(1)
                if n == "\n":
                    self.i += 2
                    continue
                w.text += n if n in '$`"\\' else "\\" + n
                self.i += 2
                continue
            if c == "$":
                self.dollar(w, in_dq=True)
                continue
            if c == "`":
                self.backtick(w, in_dq=True)
                continue
            w.text += c
            self.i += 1

    def mark(self, w, in_dq):
        w.text += DYN
        w.dynamic = True
        if not in_dq:
            w.split = True

    def nested(self, w, in_dq=False):
        """$( ), <( ) or >( ) body: its commands run too, and the word's value is unknown."""
        sub = _Lexer(self.src, self.depth + 1)
        sub.i = self.i
        sub.parse_list(")", False)
        if sub.heredocs:
            raise Unparseable("here-document inside a substitution without a newline")
        self.i = sub.i
        self.out.extend(sub.out)
        self.mark(w, in_dq)

    def dollar(self, w, in_dq):
        n = self.peek(1)
        if n == "(":
            if self.peek(2) == "(":
                end = self.src.find("))", self.i + 3)
                if end < 0:
                    raise Unparseable("unclosed $((")
                inner = self.src[self.i + 3:end]
                # a name in arithmetic is evaluated again, so a variable holding 'a[$(cmd)]' runs cmd
                if "$(" in inner or "`" in inner or "(" in inner or re.search(r"[A-Za-z_]", inner):
                    raise Unparseable("arithmetic expansion with names")
                self.i = end + 2
                self.mark(w, in_dq)
                return
            self.i += 2
            self.nested(w, in_dq)
            return
        if n == "[":
            raise Unparseable("$[ ] arithmetic is not supported")
        if n == "{":
            depth, j = 0, self.i + 1
            while j < len(self.src):
                if self.src[j] == "\\":
                    raise Unparseable("backslash inside ${...}")
                if self.src[j] == "{":
                    depth += 1
                elif self.src[j] == "}":
                    depth -= 1
                    if depth == 0:
                        break
                j += 1
            else:
                raise Unparseable("unclosed ${")
            inner = self.src[self.i + 2:j]
            if "$" in inner or "`" in inner or "'" in inner or '"' in inner or "(" in inner or re.search(
                    r"@[A-Za-z]$|\[[^\]]*[A-Za-z_]", inner):  # a[name] is arithmetic: name's value is evaluated
                raise Unparseable("complex parameter expansion")  # ${x@P} expands prompt codes, $(...) included
            self.i = j + 1
            self.mark(w, in_dq)
            return
        if n == "'" and not in_dq:
            j = self.i + 2
            while j < len(self.src) and self.src[j] != "'":
                j += 2 if self.src[j] == "\\" else 1
            if j >= len(self.src):
                raise Unparseable("unclosed $'")
            self.i = j + 1
            self.mark(w, True)  # one word, value decoded at run time
            w.ansi = True
            return
        if n == '"' and not in_dq:
            self.i += 2
            self.double_quoted(w)
            self.mark(w, True)
            return
        m = re.compile(r"[A-Za-z_][A-Za-z0-9_]*|[0-9@*#?$!-]").match(self.src, self.i + 1)
        if m:
            self.i = m.end()
            self.mark(w, in_dq)
            return
        w.text += "$"
        self.i += 1

    def backtick(self, w, in_dq):
        j, body = self.i + 1, []
        while j < len(self.src) and self.src[j] != "`":
            if self.src[j] == "\\" and j + 1 < len(self.src) and self.src[j + 1] in "`$\\":
                body.append(self.src[j + 1])
                j += 2
                continue
            body.append(self.src[j])
            j += 1
        if j >= len(self.src):
            raise Unparseable("unclosed backtick")
        self.out.extend(_Lexer("".join(body), self.depth + 1).parse())
        self.i = j + 1
        self.mark(w, in_dq)


def shell_commands(command):
    """Every simple command in a bash command string, the ones in substitutions included. Raises Unparseable."""
    return _Lexer(command).parse()


def _mentions_guarded(command):
    """True when the text names gh, git or prbot once quotes, backslashes and line continuations are removed."""
    return GUARD_MENTION.search(re.sub(r"[\\'\"]", "", command.replace("\\\n", ""))) is not None


